    "%%writefile groundwater_explainer.py\n",
    "#!/usr/bin/env python3\n",
    "\"\"\"\n",
    "Plain-language explanations for the groundwater model\n",
    "=====================================================\n",
    "Turns the model's numbers into answers to three questions:\n",
    "\n",
    "  1. WHY is this station Safe / Moderate / Critical?      (the rule, shown step by step)\n",
    "  2. WHY does the model expect the water level to move?    (SHAP-style contributions, grouped into 5 causes)\n",
    "  3. HOW SURE is the model?                                (calibrated class probabilities)\n",
    "\n",
    "Used by groundwater_pipeline.py (all stations) and groundwater_predictor.py (your own data).\n",
    "\"\"\"\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "CLASSES = [\"Safe\", \"Moderate\", \"Critical\"]\n",
    "MON = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\n",
    "\n",
    "GROUP_ORDER = [\"Season & timing\", \"Rainfall\", \"Recent readings\", \"Station history & depth\", \"Location & neighbours\"]\n",
    "GROUP_OF = {\n",
    "    \"month_t\": GROUP_ORDER[0], \"month_tgt\": GROUP_ORDER[0], \"horizon\": GROUP_ORDER[0], \"gap_prev\": GROUP_ORDER[0],\n",
    "    \"seas_delta_ly\": GROUP_ORDER[0], \"L_ly_now\": GROUP_ORDER[0], \"L_ly_tgt\": GROUP_ORDER[0],\n",
    "    \"rain3\": GROUP_ORDER[1], \"rain6\": GROUP_ORDER[1], \"rain12\": GROUP_ORDER[1],\n",
    "    \"dep3\": GROUP_ORDER[1], \"dep6\": GROUP_ORDER[1], \"dep12\": GROUP_ORDER[1],\n",
    "    \"d1\": GROUP_ORDER[2], \"d2\": GROUP_ORDER[2], \"L1\": GROUP_ORDER[2], \"L2\": GROUP_ORDER[2], \"L3\": GROUP_ORDER[2],\n",
    "    \"L0\": GROUP_ORDER[3], \"st_mean\": GROUP_ORDER[3], \"st_std\": GROUP_ORDER[3], \"n_hist\": GROUP_ORDER[3],\n",
    "    \"L0_minus_stmean\": GROUP_ORDER[3],\n",
    "    \"dist_med\": GROUP_ORDER[4], \"L0_minus_dist\": GROUP_ORDER[4], \"lat\": GROUP_ORDER[4], \"lon\": GROUP_ORDER[4],\n",
    "    \"state_code\": GROUP_ORDER[4], \"basin_code\": GROUP_ORDER[4],\n",
    "}\n",
    "ACTIONS = {\n",
    "    \"Safe\": \"Keep monitoring on the normal schedule and protect the local recharge areas.\",\n",
    "    \"Moderate\": \"Watch this station closely: encourage water-saving irrigation and recharge structures, and review its readings every season.\",\n",
    "    \"Critical\": \"Priority area: avoid new heavy withdrawals, add recharge works (check dams, percolation tanks) and monitor monthly.\",\n",
    "}\n",
    "SEPARATOR = \" | \"\n",
    "\n",
    "\n",
    "def classify(depth, sig_decline, slope, rule):\n",
    "    \"\"\"Same rule as the pipeline: depth + significant declining trend.\"\"\"\n",
    "    depth, sig, slope = np.asarray(depth, float), np.asarray(sig_decline, bool), np.asarray(slope, float)\n",
    "    crit = (depth >= rule[\"critical_from_m\"]) | (sig & (slope >= rule[\"critical_slope_m_per_yr\"]) & (depth >= rule[\"safe_below_m\"]))\n",
    "    safe = (depth < rule[\"safe_below_m\"]) & (~sig)\n",
    "    return np.where(crit, \"Critical\", np.where(safe, \"Safe\", \"Moderate\"))\n",
    "\n",
    "\n",
    "def group_contributions(booster, X, features):\n",
    "    \"\"\"SHAP-style contributions from LightGBM, summed into 5 plain-language groups (metres).\"\"\"\n",
    "    contrib = booster.predict(X[features], pred_contrib=True)\n",
    "    out = pd.DataFrame(0.0, index=range(len(X)), columns=GROUP_ORDER)\n",
    "    for j, name in enumerate(features):\n",
    "        out[GROUP_OF[name]] += contrib[:, j]\n",
    "    out[\"Typical change\"] = contrib[:, -1]\n",
    "    return out\n",
    "\n",
    "\n",
    "def confidence_label(p):\n",
    "    return \"very high\" if p >= 0.95 else \"high\" if p >= 0.80 else \"medium\" if p >= 0.60 else \"low (borderline)\"\n",
    "\n",
    "\n",
    "def reliability(n_hist, n_years, rain_used):\n",
    "    n_hist = 0 if pd.isna(n_hist) else n_hist\n",
    "    if n_hist >= 8 and rain_used:\n",
    "        return \"High\", f\"{int(n_hist)} past readings and rainfall data were available.\"\n",
    "    if n_hist >= 4:\n",
    "        why = \"\" if rain_used else \" No rainfall file was used.\"\n",
    "        return \"Medium\", f\"{int(n_hist)} past readings.{why}\"\n",
    "    return \"Low\", f\"Only {int(n_hist)} past reading(s), so the forecast is rough.\"\n",
    "\n",
    "\n",
    "def _why_class(cls, d, sig, rec, slope, p, n_years, rule):\n",
    "    s, c, cs = rule[\"safe_below_m\"], rule[\"critical_from_m\"], rule[\"critical_slope_m_per_yr\"]\n",
    "    out = [f\"Predicted water level: {d:.1f} m below ground (under {s:.0f} m is shallow, {s:.0f}-{c:.0f} m medium, {c:.0f} m or more deep).\"]\n",
    "    if pd.isna(n_years) or n_years < 5:\n",
    "        out.append(\"Long-term trend: not enough yearly data to judge (needs 5+ years).\")\n",
    "    elif sig:\n",
    "        out.append(f\"Long-term trend: getting deeper by {slope:.2f} m per year over {int(n_years)} years (statistically significant).\")\n",
    "    elif rec:\n",
    "        out.append(f\"Long-term trend: getting shallower (recovering) by {abs(slope):.2f} m per year over {int(n_years)} years (statistically significant).\")\n",
    "    else:\n",
    "        out.append(f\"Long-term trend: no significant change over {int(n_years)} years (about {slope:+.2f} m per year, not statistically significant).\")\n",
    "    if cls == \"Critical\":\n",
    "        out.append(f\"Critical because the water is {d - c:.1f} m past the {c:.0f} m deep limit.\" if d >= c else\n",
    "                   f\"Critical because the water is already {d:.1f} m deep (over {s:.0f} m) and still falling by {slope:.2f} m per year (limit {cs} m per year).\")\n",
    "    elif cls == \"Safe\":\n",
    "        out.append(f\"Safe because the water is shallow (under {s:.0f} m) and there is no significant decline.\")\n",
    "    else:\n",
    "        out.append(\"Moderate (not Safe) because, although the water is shallow, it is steadily getting deeper.\" if d < s else\n",
    "                   f\"Moderate because the water is between {s:.0f} and {c:.0f} m deep\" + (\" and getting deeper.\" if sig else \".\"))\n",
    "    return out\n",
    "\n",
    "\n",
    "def _how_close(cls, d, sig, slope, lo, hi, rule):\n",
    "    s, c, cs = rule[\"safe_below_m\"], rule[\"critical_from_m\"], rule[\"critical_slope_m_per_yr\"]\n",
    "    if cls == \"Safe\":\n",
    "        txt = f\"Headroom: {s - d:.1f} m before the water level would reach the Moderate zone.\"\n",
    "    elif cls == \"Moderate\":\n",
    "        if d < s:\n",
    "            txt = \"It would return to Safe if the decline stopped.\"\n",
    "        else:\n",
    "            txt = f\"{c - d:.1f} m from Critical and {d - s:.1f} m deeper than the Safe limit.\"\n",
    "            if sig and slope < cs:\n",
    "                txt += f\" A faster decline ({cs} m per year or more) would make it Critical.\"\n",
    "    else:\n",
    "        txt = f\"{d - c:.1f} m past the Critical limit.\" if d >= c else f\"It would drop to Moderate if the decline slowed below {cs} m per year.\"\n",
    "    return txt\n",
    "\n",
    "\n",
    "def build_explanations(rows, contrib, pred, low, high, sig, slope, pval, n_years, recovering, probs, rain_used, rule):\n",
    "    \"\"\"\n",
    "    rows     : DataFrame of the feature rows used for prediction (needs L0, d1, st_mean, ... see below)\n",
    "    contrib  : output of group_contributions (same order as rows), or None to skip the driver breakdown (fast)\n",
    "    pred/low/high : predicted level and 80% range (metres)\n",
    "    sig, slope, pval, n_years, recovering : trend arrays\n",
    "    probs    : (n, 3) class probabilities in the order Safe, Moderate, Critical (or None)\n",
    "    returns  : DataFrame of explanation columns\n",
    "    \"\"\"\n",
    "    n = len(rows)\n",
    "    pred, low, high = np.asarray(pred, float), np.asarray(low, float), np.asarray(high, float)\n",
    "    sig, slope = np.asarray(sig, bool), np.asarray(slope, float)\n",
    "    pval, n_years, recovering = np.asarray(pval, float), np.asarray(n_years, float), np.asarray(recovering, bool)\n",
    "    cls = classify(pred, sig, slope, rule)\n",
    "    cls_lo, cls_hi = classify(low, sig, slope, rule), classify(high, sig, slope, rule)\n",
    "    L0 = rows[\"L0\"].values\n",
    "    r = rows.reset_index(drop=True)\n",
    "    col = lambda name: r[name].values.astype(float) if name in r.columns else np.full(n, np.nan)\n",
    "    month_t, month_tgt, dep6, d1 = col(\"month_t\"), col(\"month_tgt\"), col(\"dep6\"), col(\"d1\")\n",
    "    st_mean, x_stmean, dist_med, n_hist = col(\"st_mean\"), col(\"L0_minus_stmean\"), col(\"dist_med\"), col(\"n_hist\")\n",
    "    cv = contrib[GROUP_ORDER].values if contrib is not None else None\n",
    "\n",
    "    why_class, how_close, why_fc, action, rel, rel_note = [], [], [], [], [], []\n",
    "    for i in range(n):\n",
    "        reasons = _why_class(cls[i], pred[i], sig[i], recovering[i], slope[i], pval[i], n_years[i], rule)\n",
    "        why_class.append(SEPARATOR.join(reasons))\n",
    "        close = _how_close(cls[i], pred[i], sig[i], slope[i], low[i], high[i], rule)\n",
    "        crossing = sorted({cls_lo[i], cls_hi[i]} - {cls[i]}, key=CLASSES.index)\n",
    "        if crossing:\n",
    "            close += f\" The likely range ({low[i]:.1f}-{high[i]:.1f} m) reaches into {' and '.join(crossing)}, so this station is close to a class boundary.\"\n",
    "        how_close.append(close)\n",
    "        action.append(ACTIONS[cls[i]])\n",
    "\n",
    "        # forecast explanation\n",
    "        delta = pred[i] - L0[i]\n",
    "        parts = [f\"Expected change: {delta:+.2f} m ({'deeper' if delta > 0 else 'shallower'}), from {L0[i]:.2f} m to {pred[i]:.2f} m.\"]\n",
    "        for j in (np.argsort(-np.abs(cv[i]), kind=\"stable\")[:3] if cv is not None else []):\n",
    "            g, c = GROUP_ORDER[j], float(cv[i, j])\n",
    "            if abs(c) < 0.10:\n",
    "                continue\n",
    "            if g == \"Season & timing\":\n",
    "                t = f\"{c:+.2f} m from the season: the usual movement between {MON[int(month_t[i]) - 1]} and {MON[int(month_tgt[i]) - 1]}\"\n",
    "            elif g == \"Rainfall\":\n",
    "                t = (f\"{c:+.2f} m linked to rainfall (the last 6 months had {dep6[i] * 100:.0f}% of normal rain; the effect also depends on the season)\"\n",
    "                     if not np.isnan(dep6[i]) else f\"{c:+.2f} m linked to rainfall (no rainfall data for this state)\")\n",
    "            elif g == \"Recent readings\":\n",
    "                t = f\"{c:+.2f} m from the recent readings (the last change was {d1[i]:+.2f} m)\" if not np.isnan(d1[i]) else f\"{c:+.2f} m from the recent readings\"\n",
    "            elif g == \"Station history & depth\":\n",
    "                x = x_stmean[i]\n",
    "                t = (f\"{c:+.2f} m because the current depth ({L0[i]:.1f} m) is {abs(x):.1f} m {'deeper' if x > 0 else 'shallower'} than this station's own average ({st_mean[i]:.1f} m), so it tends to move back towards normal\"\n",
    "                     if not np.isnan(x) and abs(x) > 0.3 else f\"{c:+.2f} m from this station's own history and depth\")\n",
    "            else:\n",
    "                t = f\"{c:+.2f} m from the district and location\" + (f\" (district median {dist_med[i]:.1f} m)\" if not np.isnan(dist_med[i]) else \"\")\n",
    "            parts.append(t + \".\")\n",
    "        if cv is None:\n",
    "            parts.append(\"The breakdown of drivers is not computed for large files; pick this station to see it.\")\n",
    "        elif len(parts) == 1:\n",
    "            parts.append(\"No single factor dominates; the change is small.\")\n",
    "        why_fc.append(SEPARATOR.join(parts))\n",
    "\n",
    "        lab, note = reliability(n_hist[i], n_years[i], rain_used)\n",
    "        rel.append(lab)\n",
    "        rel_note.append(note)\n",
    "\n",
    "    out = pd.DataFrame({\"predicted_class\": cls, \"why_class\": why_class, \"how_close_to_next_class\": how_close,\n",
    "                        \"suggested_action\": action, \"why_forecast\": why_fc,\n",
    "                        \"reliability\": rel, \"reliability_note\": rel_note})\n",
    "    if probs is not None:\n",
    "        probs = np.asarray(probs, float)\n",
    "        idx = np.array([CLASSES.index(c) for c in cls])\n",
    "        pc = probs[np.arange(n), idx]\n",
    "        out[\"confidence_pct\"] = np.round(pc * 100, 1)\n",
    "        out[\"confidence_level\"] = [confidence_label(p) for p in pc]\n",
    "        for k, nm in enumerate(CLASSES):\n",
    "            out[f\"prob_{nm.lower()}_pct\"] = np.round(probs[:, k] * 100, 1)\n",
    "    for g in GROUP_ORDER + [\"Typical change\"]:\n",
    "        out[\"contrib_\" + g.lower().replace(\" & \", \"_\").replace(\" \", \"_\")] = (\n",
    "            np.round(contrib[g].values, 3) if contrib is not None else np.nan)\n",
    "    return out"
   ]
