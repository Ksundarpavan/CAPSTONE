    "%%writefile groundwater_pipeline.py\n",
    "#!/usr/bin/env python3\n",
    "\"\"\"\n",
    "Groundwater Level Prediction + Sustainability Pipeline\n",
    "======================================================\n",
    "Capstone: \"Groundwater Analysis, Prediction and Sustainability\"\n",
    "\n",
    "Inputs (two CSV files)\n",
    "  1. CGWB depth-to-water-level data   (station-wise readings, 2013-2023)\n",
    "  2. Daily rainfall at state level    (2009-2024)\n",
    "\n",
    "What this script does\n",
    "  1. Cleans and aggregates the CGWB readings to one value per station per month\n",
    "  2. Builds monthly state rainfall features (3/6/12-month totals and departure from normal)\n",
    "  3. Builds features for \"predict the NEXT reading of each station\"\n",
    "        (previous levels, same-season-last-year level, station history, district level, rainfall)\n",
    "  4. Splits the data BY TIME  (train <= 2018, validation 2019, test >= 2020)  -> no leakage\n",
    "  5. Trains and compares: Persistence, Seasonal-naive, Ridge, Random Forest, XGBoost, LightGBM, Blend\n",
    "  6. Runs a rainfall ablation (levels only / + past rain / + rain in the forecast window)\n",
    "  7. Sustainability: Mann-Kendall + Sen's slope per station, Safe/Moderate/Critical class\n",
    "        per station and per state-basin, plus class accuracy of the model on the test period\n",
    "  8. Saves the model, metrics, predictions, tables and charts\n",
    "\n",
    "Usage\n",
    "  python groundwater_pipeline.py --levels <cgwb.csv> --rain <rainfall.csv> --out outputs\n",
    "\"\"\"\n",
    "import argparse\n",
    "import json\n",
    "import time\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import joblib\n",
    "import lightgbm as lgb\n",
    "import matplotlib\n",
    "\n",
    "matplotlib.use(\"Agg\")\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import xgboost as xgb\n",
    "\n",
    "import groundwater_explainer as gx\n",
    "from scipy import stats\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import Ridge\n",
    "from sklearn.metrics import (accuracy_score, balanced_accuracy_score, confusion_matrix,\n",
    "                             f1_score, mean_absolute_error, mean_squared_error, r2_score)\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# Settings\n",
    "# ----------------------------------------------------------------------------\n",
    "def mi_of(year, month):          # integer \"month index\" used everywhere instead of dates\n",
    "    return (year - 1970) * 12 + (month - 1)\n",
    "\n",
    "\n",
    "TRAIN_END = mi_of(2018, 12)      # target month <= Dec-2018  -> training\n",
    "VAL_END = mi_of(2019, 12)        # target month in 2019      -> validation\n",
    "MAX_GAP = 6                      # only learn from readings <= 6 months apart\n",
    "NEXT_MONTH = {1: 5, 5: 8, 8: 11, 11: 1}   # usual CGWB reading calendar (Jan, May, Aug, Nov)\n",
    "DEPTH_SAFE, DEPTH_CRITICAL = 10.0, 20.0   # metres below ground level\n",
    "SLOPE_CRITICAL = 0.5                      # m/year, with a significant declining trend\n",
    "CLASSES = [\"Safe\", \"Moderate\", \"Critical\"]\n",
    "\n",
    "BASE_FEATURES = [\n",
    "    \"L0\", \"L1\", \"L2\", \"L3\", \"d1\", \"d2\", \"gap_prev\", \"st_mean\", \"st_std\", \"n_hist\",\n",
    "    \"L0_minus_stmean\", \"L_ly_now\", \"L_ly_tgt\", \"seas_delta_ly\", \"dist_med\", \"L0_minus_dist\",\n",
    "    \"lat\", \"lon\", \"state_code\", \"basin_code\", \"month_t\", \"month_tgt\", \"horizon\",\n",
    "]\n",
    "PAST_RAIN = [\"rain3\", \"rain6\", \"rain12\", \"dep3\", \"dep6\", \"dep12\"]\n",
    "WINDOW_RAIN = [\"rain_tgt3\", \"dep_tgt3\", \"rain_tgt6\", \"dep_tgt6\"]\n",
    "\n",
    "\n",
    "def log(msg):\n",
    "    print(f\"[{time.strftime('%H:%M:%S')}] {msg}\", flush=True)\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 1. Load + clean CGWB levels\n",
    "# ----------------------------------------------------------------------------\n",
    "def load_levels(path):\n",
    "    cols = [\"date\", \"state_name\", \"district_name\", \"station_name\", \"latitude\",\n",
    "            \"longitude\", \"basin\", \"currentlevel\"]\n",
    "    df = pd.read_csv(path, usecols=cols, parse_dates=[\"date\"])\n",
    "    n0 = len(df)\n",
    "    df = df.dropna(subset=[\"currentlevel\", \"latitude\", \"longitude\", \"date\"])\n",
    "    df = df[df.currentlevel >= 0]\n",
    "    key = (df.state_name + \"|\" + df.district_name + \"|\" + df.station_name + \"|\" +\n",
    "           df.latitude.round(4).astype(str) + \"|\" + df.longitude.round(4).astype(str))\n",
    "    df[\"sid\"] = pd.factorize(key)[0]\n",
    "    df[\"mi\"] = mi_of(df.date.dt.year, df.date.dt.month)\n",
    "    m = (df.groupby([\"sid\", \"mi\"], as_index=False)\n",
    "           .agg(level=(\"currentlevel\", \"median\"), state=(\"state_name\", \"first\"),\n",
    "                district=(\"district_name\", \"first\"), station=(\"station_name\", \"first\"),\n",
    "                basin=(\"basin\", \"first\"), lat=(\"latitude\", \"first\"), lon=(\"longitude\", \"first\")))\n",
    "    m = m.sort_values([\"sid\", \"mi\"]).reset_index(drop=True)\n",
    "\n",
    "    # remove isolated sensor spikes: far from BOTH neighbours while the neighbours agree\n",
    "    g = m.groupby(\"sid\")[\"level\"]\n",
    "    prev, nxt = g.shift(1), g.shift(-1)\n",
    "    spike = ((m.level - prev).abs() > 20) & ((m.level - nxt).abs() > 20) & \\\n",
    "            ((prev - nxt).abs() < 0.5 * np.minimum((m.level - prev).abs(), (m.level - nxt).abs()))\n",
    "    n_spike = int(spike.sum())\n",
    "    m = m[~spike].reset_index(drop=True)\n",
    "\n",
    "    m[\"skey\"] = m.state.str.lower().str.strip()\n",
    "    m[\"year\"] = (m.mi // 12) + 1970\n",
    "    m[\"month\"] = (m.mi % 12) + 1\n",
    "    info = {\"raw_rows\": int(n0), \"rows_after_cleaning\": int(len(df)),\n",
    "            \"station_months\": int(len(m)), \"stations\": int(m.sid.nunique()),\n",
    "            \"spikes_removed\": n_spike}\n",
    "    log(f\"levels: {info}\")\n",
    "    return m, info\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 2. Monthly state rainfall features\n",
    "# ----------------------------------------------------------------------------\n",
    "def load_rain(path):\n",
    "    r = pd.read_csv(path, parse_dates=[\"date\"])\n",
    "    r[\"skey\"] = r.state_name.str.lower().str.strip()\n",
    "    r[\"mi\"] = mi_of(r.date.dt.year, r.date.dt.month)\n",
    "    r[\"dim\"] = r.date.dt.days_in_month\n",
    "    a = r.groupby([\"skey\", \"mi\"]).agg(a_sum=(\"actual\", \"sum\"), a_n=(\"actual\", \"count\"), dim=(\"dim\", \"first\"))\n",
    "    n = r.groupby([\"skey\", \"mi\"]).agg(n_sum=(\"normal\", \"sum\"), n_n=(\"normal\", \"count\"))\n",
    "    mon = a.join(n)\n",
    "    mon[\"act\"] = np.where(mon.a_n >= 20, mon.a_sum / mon.a_n * mon.dim, np.nan)\n",
    "    mon[\"nor\"] = np.where(mon.n_n >= 20, mon.n_sum / mon.n_n * mon.dim, np.nan)\n",
    "    mon = mon.reset_index()\n",
    "\n",
    "    out = []\n",
    "    for sk, g in mon.groupby(\"skey\"):\n",
    "        full = pd.DataFrame({\"mi\": np.arange(g.mi.min(), g.mi.max() + 1)})\n",
    "        g = full.merge(g[[\"mi\", \"act\", \"nor\"]], on=\"mi\", how=\"left\")\n",
    "        res = {\"skey\": sk, \"mi\": g.mi.values}\n",
    "        for w in (3, 6, 12):\n",
    "            mp = max(2, int(w * 0.66))\n",
    "            ra = g.act.rolling(w, min_periods=mp).mean() * w\n",
    "            rn = g.nor.rolling(w, min_periods=mp).mean() * w\n",
    "            res[f\"rain{w}\"] = ra.values\n",
    "            res[f\"dep{w}\"] = (ra / rn.where(rn > 1)).clip(0, 5).values   # actual / normal\n",
    "        out.append(pd.DataFrame(res))\n",
    "    rain = pd.concat(out, ignore_index=True)\n",
    "    log(f\"rainfall: {len(rain)} state-months, {rain.skey.nunique()} states\")\n",
    "    return rain\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 3. Features\n",
    "# ----------------------------------------------------------------------------\n",
    "def build_features(m, rain, maps=None, forecast_horizon=None):\n",
    "    m = m.sort_values([\"sid\", \"mi\"]).reset_index(drop=True).copy()\n",
    "    g = m.groupby(\"sid\")\n",
    "    m[\"L0\"] = m.level\n",
    "    for k in (1, 2, 3):\n",
    "        m[f\"L{k}\"] = g[\"level\"].shift(k)\n",
    "    m[\"d1\"] = m.L0 - m.L1\n",
    "    m[\"d2\"] = m.L1 - m.L2\n",
    "    m[\"gap_prev\"] = m.mi - g[\"mi\"].shift(1)\n",
    "\n",
    "    # next reading (target)\n",
    "    m[\"y_next\"] = g[\"level\"].shift(-1)\n",
    "    nxt_mi = g[\"mi\"].shift(-1)\n",
    "    m[\"has_target\"] = nxt_mi.notna()\n",
    "    gap_rule = (m.month.map(NEXT_MONTH).fillna((m.month + 2) % 12 + 1) - m.month) % 12\n",
    "    gap_rule = gap_rule.replace(0, 12)\n",
    "    if forecast_horizon:                       # user asked for \"N months after the last reading\"\n",
    "        gap_rule = pd.Series(int(forecast_horizon), index=m.index)\n",
    "    m[\"tgt_mi\"] = nxt_mi.fillna(m.mi + gap_rule).astype(\"int64\")\n",
    "    m[\"horizon\"] = m.tgt_mi - m.mi\n",
    "    m[\"month_t\"] = m.month\n",
    "    m[\"month_tgt\"] = (m.tgt_mi % 12) + 1\n",
    "\n",
    "    # station history (expanding, includes only readings up to the current one)\n",
    "    n = g.cumcount() + 1\n",
    "    cs = g[\"level\"].cumsum()\n",
    "    cs2 = (m.level ** 2).groupby(m.sid).cumsum()\n",
    "    m[\"n_hist\"] = n\n",
    "    m[\"st_mean\"] = cs / n\n",
    "    m[\"st_std\"] = np.sqrt((cs2 / n - m.st_mean ** 2).clip(lower=0))\n",
    "    m[\"L0_minus_stmean\"] = m.L0 - m.st_mean\n",
    "\n",
    "    # same season last year\n",
    "    lvl = m.set_index([\"sid\", \"mi\"]).level\n",
    "    def lookup(mi_arr):\n",
    "        return lvl.reindex(pd.MultiIndex.from_arrays([m.sid.values, mi_arr])).values\n",
    "    m[\"L_ly_now\"] = lookup((m.mi - 12).values)\n",
    "    m[\"L_ly_tgt\"] = lookup((m.tgt_mi - 12).values)\n",
    "    m[\"seas_delta_ly\"] = m.L_ly_tgt - m.L_ly_now\n",
    "\n",
    "    # district level at the same month (spatial context)\n",
    "    m[\"dist_med\"] = m.groupby([\"state\", \"district\", \"mi\"])[\"level\"].transform(\"median\")\n",
    "    m[\"L0_minus_dist\"] = m.L0 - m.dist_med\n",
    "\n",
    "    if maps is None:                           # training: create the category codes\n",
    "        m[\"state_code\"] = pd.factorize(m.skey)[0]\n",
    "        m[\"basin_code\"] = pd.factorize(m.basin)[0]\n",
    "    else:                                      # new data: reuse the codes the model was trained with\n",
    "        m[\"state_code\"] = m.skey.map(maps[\"state\"])\n",
    "        m[\"basin_code\"] = m.basin.map(maps[\"basin\"])\n",
    "\n",
    "    # rainfall: up to the current reading month (safe for forecasting)\n",
    "    r_now = rain.rename(columns={c: c for c in rain.columns})\n",
    "    m = m.merge(r_now, on=[\"skey\", \"mi\"], how=\"left\")\n",
    "    # rainfall inside the forecast window (only valid if the monsoon outcome / a scenario is known)\n",
    "    r_t = rain[[\"skey\", \"mi\", \"rain3\", \"dep3\", \"rain6\", \"dep6\"]].rename(\n",
    "        columns={\"mi\": \"tgt_mi\", \"rain3\": \"rain_tgt3\", \"dep3\": \"dep_tgt3\",\n",
    "                 \"rain6\": \"rain_tgt6\", \"dep6\": \"dep_tgt6\"})\n",
    "    m = m.merge(r_t, on=[\"skey\", \"tgt_mi\"], how=\"left\")\n",
    "    m[\"target_delta\"] = m.y_next - m.L0\n",
    "    return m\n",
    "\n",
    "\n",
    "def split_masks(f):\n",
    "    ok = f.has_target & (f.horizon >= 1) & (f.horizon <= MAX_GAP)\n",
    "    train = ok & (f.tgt_mi <= TRAIN_END)\n",
    "    val = ok & (f.tgt_mi > TRAIN_END) & (f.tgt_mi <= VAL_END)\n",
    "    test = ok & (f.tgt_mi > VAL_END)\n",
    "    return train, val, test\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 4. Metrics\n",
    "# ----------------------------------------------------------------------------\n",
    "def reg_metrics(y, pred, base):\n",
    "    err = pred - y\n",
    "    mse = mean_squared_error(y, pred)\n",
    "    mse_base = mean_squared_error(y, base)\n",
    "    return {\n",
    "        \"R2_level\": r2_score(y, pred),\n",
    "        \"RMSE_m\": float(np.sqrt(mse)),\n",
    "        \"MAE_m\": mean_absolute_error(y, pred),\n",
    "        \"MedianAE_m\": float(np.median(np.abs(err))),\n",
    "        \"within_0.5m_%\": float(np.mean(np.abs(err) <= 0.5) * 100),\n",
    "        \"within_1m_%\": float(np.mean(np.abs(err) <= 1.0) * 100),\n",
    "        \"within_2m_%\": float(np.mean(np.abs(err) <= 2.0) * 100),\n",
    "        \"R2_of_change\": r2_score(y - base, pred - base),\n",
    "        \"skill_vs_persistence\": float(1 - mse / mse_base),\n",
    "    }\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 5. Sustainability (Mann-Kendall + Sen's slope) and classes\n",
    "# ----------------------------------------------------------------------------\n",
    "def station_trends(m, upto_mi=None, min_years=5):\n",
    "    d = m if upto_mi is None else m[m.mi <= upto_mi]\n",
    "    d = d[[\"sid\", \"year\", \"month\", \"level\"]].copy()\n",
    "    d[\"anom\"] = d.level - d.groupby([\"sid\", \"month\"])[\"level\"].transform(\"mean\")   # removes the seasonal cycle\n",
    "    ann = d.groupby([\"sid\", \"year\"], as_index=False).anom.mean()\n",
    "    cnt = ann.groupby(\"sid\").size()\n",
    "    keep = cnt[cnt >= min_years].index\n",
    "    rows = []\n",
    "    for sid, g in ann[ann.sid.isin(keep)].groupby(\"sid\"):\n",
    "        x, y = g.year.values, g.anom.values\n",
    "        tau, p = stats.kendalltau(x, y)\n",
    "        slope = stats.theilslopes(y, x)[0]\n",
    "        rows.append((sid, len(g), tau, p, slope))\n",
    "    t = pd.DataFrame(rows, columns=[\"sid\", \"n_years\", \"mk_tau\", \"mk_p\", \"sen_slope_m_per_yr\"])\n",
    "    t[\"sig_decline\"] = (t.mk_p < 0.05) & (t.sen_slope_m_per_yr > 0)    # + slope = water table getting deeper\n",
    "    t[\"sig_recovery\"] = (t.mk_p < 0.05) & (t.sen_slope_m_per_yr < 0)\n",
    "    return t\n",
    "\n",
    "\n",
    "def sustainability_class(depth, sig_decl, slope):\n",
    "    depth, sig_decl, slope = np.asarray(depth, float), np.asarray(sig_decl, bool), np.asarray(slope, float)\n",
    "    critical = (depth >= DEPTH_CRITICAL) | (sig_decl & (slope >= SLOPE_CRITICAL) & (depth >= DEPTH_SAFE))\n",
    "    safe = (depth < DEPTH_SAFE) & (~sig_decl)\n",
    "    return np.where(critical, \"Critical\", np.where(safe, \"Safe\", \"Moderate\"))\n",
    "\n",
    "\n",
    "def attach_trend(f, trends):\n",
    "    t = trends.set_index(\"sid\")\n",
    "    sd = f.sid.map(t.sig_decline).fillna(False).astype(bool).values\n",
    "    sl = f.sid.map(t.sen_slope_m_per_yr).fillna(0.0).values\n",
    "    return sd, sl\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 6. Model helpers\n",
    "# ----------------------------------------------------------------------------\n",
    "LGB_PARAMS = dict(objective=\"regression\", learning_rate=0.05, num_leaves=127, min_child_samples=30,\n",
    "                  subsample=0.8, subsample_freq=1, colsample_bytree=0.8, reg_lambda=1.0)\n",
    "\n",
    "\n",
    "def fit_lgb(Xtr, ytr, Xva, yva, cats, params=None):\n",
    "    mdl = lgb.LGBMRegressor(n_estimators=3000, n_jobs=1, random_state=SEED, verbose=-1, **(params or LGB_PARAMS))\n",
    "    mdl.fit(Xtr, ytr, eval_set=[(Xva, yva)], eval_metric=\"l2\", categorical_feature=cats,\n",
    "            callbacks=[lgb.early_stopping(60, verbose=False)])\n",
    "    return mdl\n",
    "\n",
    "\n",
    "def tune_lgb(Xtr, ytr, Xva, yva, cats, trials=10):\n",
    "    \"\"\"Random search. The ONLY data used to pick the winner is the validation year (2019).\"\"\"\n",
    "    rng = np.random.RandomState(SEED)\n",
    "    best_p, best_rmse, best_mdl = dict(LGB_PARAMS), None, None\n",
    "    cand = [dict(LGB_PARAMS)]\n",
    "    for _ in range(trials):\n",
    "        cand.append(dict(objective=str(rng.choice([\"regression\", \"huber\"])),\n",
    "                         learning_rate=float(rng.choice([0.05, 0.08])),\n",
    "                         num_leaves=int(rng.choice([31, 63, 127, 255])),\n",
    "                         min_child_samples=int(rng.choice([10, 30, 60, 100])),\n",
    "                         subsample=float(rng.choice([0.7, 0.8, 0.9])), subsample_freq=1,\n",
    "                         colsample_bytree=float(rng.choice([0.5, 0.7, 0.9])),\n",
    "                         reg_lambda=float(rng.choice([0.0, 1.0, 5.0, 20.0]))))\n",
    "    log_rows = []\n",
    "    for i, p in enumerate(cand):\n",
    "        mdl = fit_lgb(Xtr, ytr, Xva, yva, cats, params=p)\n",
    "        rmse = float(np.sqrt(mean_squared_error(yva, mdl.predict(Xva))))\n",
    "        log_rows.append((i, rmse, mdl.best_iteration_, p))\n",
    "        log(f\"  tuning trial {i:2d}  val RMSE={rmse:.4f}  iters={mdl.best_iteration_}  \"\n",
    "            f\"{p['objective']}, leaves={p['num_leaves']}, lr={p['learning_rate']}\")\n",
    "        if best_rmse is None or rmse < best_rmse:\n",
    "            best_p, best_rmse, best_mdl = p, rmse, mdl\n",
    "    return best_p, best_rmse, log_rows, best_mdl\n",
    "\n",
    "\n",
    "def fit_quantile(Xtr, ytr, Xva, yva, cats, alpha, n_estimators=None):\n",
    "    kw = dict(objective=\"quantile\", alpha=alpha, learning_rate=0.05, num_leaves=63, min_child_samples=50,\n",
    "              subsample=0.8, subsample_freq=1, colsample_bytree=0.8, reg_lambda=1.0,\n",
    "              n_jobs=1, random_state=SEED, verbose=-1)\n",
    "    if n_estimators is None:\n",
    "        mdl = lgb.LGBMRegressor(n_estimators=3000, **kw)\n",
    "        mdl.fit(Xtr, ytr, eval_set=[(Xva, yva)], eval_metric=\"quantile\", categorical_feature=cats,\n",
    "                callbacks=[lgb.early_stopping(60, verbose=False)])\n",
    "    else:\n",
    "        mdl = lgb.LGBMRegressor(n_estimators=n_estimators, **kw)\n",
    "        mdl.fit(Xtr, ytr, categorical_feature=cats)\n",
    "    return mdl\n",
    "\n",
    "\n",
    "def fit_xgb(Xtr, ytr, Xva, yva):\n",
    "    mdl = xgb.XGBRegressor(n_estimators=3000, learning_rate=0.05, max_depth=8, min_child_weight=5,\n",
    "                           subsample=0.8, colsample_bytree=0.8, tree_method=\"hist\", n_jobs=1,\n",
    "                           random_state=SEED, early_stopping_rounds=60)\n",
    "    mdl.fit(Xtr, ytr, eval_set=[(Xva, yva)], verbose=False)\n",
    "    return mdl\n",
    "\n",
    "\n",
    "def fit_rf(Xtr, ytr):\n",
    "    mdl = RandomForestRegressor(n_estimators=60, max_depth=16, min_samples_leaf=8, max_features=0.5,\n",
    "                                max_samples=0.15, n_jobs=1, random_state=SEED)\n",
    "    mdl.fit(Xtr, ytr)\n",
    "    return mdl\n",
    "\n",
    "\n",
    "def fit_ridge(Xtr, ytr):\n",
    "    mdl = make_pipeline(SimpleImputer(strategy=\"median\"), StandardScaler(), Ridge(alpha=5.0))\n",
    "    mdl.fit(Xtr, ytr)\n",
    "    return mdl\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 7. Plots\n",
    "# ----------------------------------------------------------------------------\n",
    "PAL = {\"Safe\": \"#2E7D32\", \"Moderate\": \"#F9A825\", \"Critical\": \"#C62828\"}\n",
    "\n",
    "\n",
    "def plot_model_comparison(tab, path):\n",
    "    fig, ax = plt.subplots(1, 3, figsize=(13, 4))\n",
    "    t = tab.sort_values(\"RMSE_m\", ascending=False)\n",
    "    cols = [\"#90A4AE\"] * len(t)\n",
    "    best = t.RMSE_m.idxmin()\n",
    "    cols = [\"#1565C0\" if i == best else c for i, c in zip(t.index, cols)]\n",
    "    for a, met, title in zip(ax, [\"RMSE_m\", \"MAE_m\", \"R2_level\"], [\"RMSE (m)  lower = better\", \"MAE (m)  lower = better\", \"R\\u00b2 on level  higher = better\"]):\n",
    "        a.barh(t.index, t[met], color=cols)\n",
    "        a.set_title(title, fontsize=10)\n",
    "        for y, v in enumerate(t[met]):\n",
    "            a.text(v, y, f\" {v:.3f}\", va=\"center\", fontsize=8)\n",
    "        if met == \"R2_level\":\n",
    "            a.set_xlim(max(0, t[met].min() - 0.02), 1.0)\n",
    "    plt.suptitle(\"Model comparison on the TEST period (2020 onwards)\", fontsize=12)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_actual_vs_pred(y, p, path, title):\n",
    "    fig, ax = plt.subplots(1, 2, figsize=(11, 4.6))\n",
    "    lim = 40\n",
    "    ax[0].hexbin(y, p, gridsize=70, extent=(0, lim, 0, lim), bins=\"log\", cmap=\"viridis\", mincnt=1)\n",
    "    ax[0].plot([0, lim], [0, lim], \"r--\", lw=1)\n",
    "    ax[0].set_xlabel(\"Actual depth to water (m)\")\n",
    "    ax[0].set_ylabel(\"Predicted depth to water (m)\")\n",
    "    ax[0].set_title(\"Actual vs predicted (0\\u201340 m, log density)\")\n",
    "    err = np.clip(p - y, -6, 6)\n",
    "    ax[1].hist(err, bins=120, color=\"#1565C0\")\n",
    "    ax[1].axvline(0, color=\"r\", lw=1)\n",
    "    ax[1].set_xlabel(\"Prediction error (m)  [clipped at \\u00b16 m]\")\n",
    "    ax[1].set_ylabel(\"Number of test readings\")\n",
    "    ax[1].set_title(\"Error distribution\")\n",
    "    plt.suptitle(title, fontsize=11)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_importance(model, names, path):\n",
    "    imp = pd.Series(model.booster_.feature_importance(\"gain\"), index=names).sort_values()\n",
    "    imp = imp / imp.sum() * 100\n",
    "    imp = imp.tail(18)\n",
    "    fig, ax = plt.subplots(figsize=(7, 5.5))\n",
    "    ax.barh(imp.index, imp.values, color=\"#2E7D32\")\n",
    "    ax.set_xlabel(\"Share of model gain (%)\")\n",
    "    ax.set_title(\"What drives the next-reading prediction (LightGBM)\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_ablation(abl, path):\n",
    "    fig, ax = plt.subplots(figsize=(7.5, 3.6))\n",
    "    ax.barh(abl.index[::-1], abl.RMSE_m[::-1], color=[\"#1565C0\", \"#2E7D32\", \"#90A4AE\"][::-1][: len(abl)])\n",
    "    for y, v in enumerate(abl.RMSE_m[::-1]):\n",
    "        ax.text(v, y, f\" {v:.3f} m\", va=\"center\", fontsize=9)\n",
    "    ax.set_xlabel(\"Test RMSE (m)  lower = better\")\n",
    "    ax.set_title(\"Does rainfall help?  (same model, different inputs)\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_map(st, path):\n",
    "    fig, ax = plt.subplots(figsize=(7, 7.5))\n",
    "    for c in CLASSES:\n",
    "        s = st[st.sustainability_class == c]\n",
    "        ax.scatter(s.lon, s.lat, s=3, c=PAL[c], label=f\"{c} ({len(s):,})\", alpha=0.7)\n",
    "    ax.set_xlim(67, 98)\n",
    "    ax.set_ylim(6, 37)\n",
    "    ax.set_xlabel(\"Longitude\")\n",
    "    ax.set_ylabel(\"Latitude\")\n",
    "    ax.set_title(\"Station-wise groundwater sustainability class\")\n",
    "    ax.legend(markerscale=4, loc=\"lower left\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_state_bar(sb, path):\n",
    "    s = sb.groupby(\"state\").agg(n=(\"n_stations\", \"sum\"), crit=(\"n_critical\", \"sum\"), mod=(\"n_moderate\", \"sum\"),\n",
    "                                 safe=(\"n_safe\", \"sum\"))\n",
    "    s = s[s.n >= 50]\n",
    "    s[\"pc\"] = s.crit / s.n * 100\n",
    "    s[\"pm\"] = s[\"mod\"] / s.n * 100\n",
    "    s[\"ps\"] = s.safe / s.n * 100\n",
    "    s = s.sort_values(\"pc\")\n",
    "    fig, ax = plt.subplots(figsize=(8, 7.5))\n",
    "    ax.barh(s.index, s.ps, color=PAL[\"Safe\"], label=\"Safe\")\n",
    "    ax.barh(s.index, s.pm, left=s.ps, color=PAL[\"Moderate\"], label=\"Moderate\")\n",
    "    ax.barh(s.index, s.pc, left=s.ps + s.pm, color=PAL[\"Critical\"], label=\"Critical\")\n",
    "    ax.set_xlabel(\"% of monitoring stations\")\n",
    "    ax.set_title(\"Sustainability class mix by state\")\n",
    "    ax.legend(loc=\"lower right\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def plot_confusion(cm, path, title):\n",
    "    fig, ax = plt.subplots(figsize=(4.8, 4.2))\n",
    "    ax.imshow(cm, cmap=\"Blues\")\n",
    "    ax.set_xticks(range(3)); ax.set_xticklabels(CLASSES)\n",
    "    ax.set_yticks(range(3)); ax.set_yticklabels(CLASSES)\n",
    "    ax.set_xlabel(\"Predicted class\"); ax.set_ylabel(\"Actual class\")\n",
    "    for i in range(3):\n",
    "        for j in range(3):\n",
    "            ax.text(j, i, f\"{cm[i, j]:,}\", ha=\"center\", va=\"center\",\n",
    "                    color=\"white\" if cm[i, j] > cm.max() / 2 else \"black\", fontsize=9)\n",
    "    ax.set_title(title, fontsize=10)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# main\n",
    "# ----------------------------------------------------------------------------\n",
    "def main():\n",
    "    ap = argparse.ArgumentParser()\n",
    "    ap.add_argument(\"--levels\", default=\"cgwb-changes-in-depth-to-water-level_datase_1.csv\")\n",
    "    ap.add_argument(\"--rain\", default=\"daily-rainfall-at-state-level.csv\")\n",
    "    ap.add_argument(\"--out\", default=\"outputs\")\n",
    "    ap.add_argument(\"--skip-rf\", action=\"store_true\", help=\"skip the (slow) Random Forest\")\n",
    "    ap.add_argument(\"--tune-trials\", type=int, default=10, help=\"random-search trials for LightGBM\")\n",
    "    args = ap.parse_args()\n",
    "    out = Path(args.out)\n",
    "    out.mkdir(parents=True, exist_ok=True)\n",
    "    results = {}\n",
    "\n",
    "    # ---- data ----\n",
    "    m, info = load_levels(args.levels)\n",
    "    results[\"data\"] = info\n",
    "    rain = load_rain(args.rain)\n",
    "    f = build_features(m, rain)\n",
    "    tr_m, va_m, te_m = split_masks(f)\n",
    "    results[\"rows\"] = {\"train\": int(tr_m.sum()), \"validation\": int(va_m.sum()), \"test\": int(te_m.sum())}\n",
    "    log(f\"rows: {results['rows']}\")\n",
    "\n",
    "    feats_A = BASE_FEATURES\n",
    "    feats_B = BASE_FEATURES + PAST_RAIN\n",
    "    feats_C = BASE_FEATURES + PAST_RAIN + WINDOW_RAIN\n",
    "    cats = [\"state_code\", \"basin_code\"]\n",
    "\n",
    "    y_all = f.target_delta\n",
    "    L0 = f.L0\n",
    "    def level_pred(delta, mask):\n",
    "        return L0[mask].values + delta\n",
    "\n",
    "    ytr_lvl, yva_lvl, yte_lvl = f.y_next[tr_m].values, f.y_next[va_m].values, f.y_next[te_m].values\n",
    "    base_te = L0[te_m].values\n",
    "\n",
    "    # ---- baselines ----\n",
    "    rows = {}\n",
    "    rows[\"Persistence (last level)\"] = reg_metrics(yte_lvl, base_te, base_te)\n",
    "    seas = np.where(f.seas_delta_ly[te_m].notna(), L0[te_m] + f.seas_delta_ly[te_m], L0[te_m])\n",
    "    rows[\"Seasonal naive (last-year change)\"] = reg_metrics(yte_lvl, seas, base_te)\n",
    "\n",
    "    # ---- main models on feature set B (levels + past rain = usable for real forecasting) ----\n",
    "    XB = {k: f.loc[msk, feats_B].astype(\"float32\") for k, msk in zip([\"tr\", \"va\", \"te\"], [tr_m, va_m, te_m])}\n",
    "    d_tr, d_va = y_all[tr_m].values, y_all[va_m].values\n",
    "    preds_te, preds_va, models = {}, {}, {}\n",
    "\n",
    "    log(\"training Ridge ...\")\n",
    "    mdl = fit_ridge(XB[\"tr\"], d_tr)\n",
    "    preds_te[\"Ridge\"], preds_va[\"Ridge\"] = mdl.predict(XB[\"te\"]), mdl.predict(XB[\"va\"]); models[\"Ridge\"] = mdl\n",
    "\n",
    "    log(\"tuning + training LightGBM (selection uses the validation year only) ...\")\n",
    "    t0 = time.time()\n",
    "    best_p, best_val, trials, lg = tune_lgb(XB[\"tr\"], d_tr, XB[\"va\"], d_va, cats, trials=args.tune_trials)\n",
    "    LGB_PARAMS.update(best_p)\n",
    "    results[\"lightgbm_tuning\"] = {\"default_val_RMSE_m\": trials[0][1], \"tuned_val_RMSE_m\": best_val,\n",
    "                                  \"best_params\": best_p,\n",
    "                                  \"trials\": [{\"trial\": t[0], \"val_RMSE_m\": t[1], \"iters\": t[2]} for t in trials]}\n",
    "    log(f\"  default val RMSE {trials[0][1]:.4f}  ->  tuned {best_val:.4f}\")\n",
    "    preds_te[\"LightGBM\"], preds_va[\"LightGBM\"] = lg.predict(XB[\"te\"]), lg.predict(XB[\"va\"]); models[\"LightGBM\"] = lg\n",
    "    log(f\"  LightGBM best_iter={lg.best_iteration_}  ({time.time()-t0:.0f}s)\")\n",
    "\n",
    "    log(\"training XGBoost ...\")\n",
    "    t0 = time.time()\n",
    "    xg = fit_xgb(XB[\"tr\"], d_tr, XB[\"va\"], d_va)\n",
    "    preds_te[\"XGBoost\"], preds_va[\"XGBoost\"] = xg.predict(XB[\"te\"]), xg.predict(XB[\"va\"]); models[\"XGBoost\"] = xg\n",
    "    log(f\"  XGBoost best_iter={xg.best_iteration}  ({time.time()-t0:.0f}s)\")\n",
    "\n",
    "    if not args.skip_rf:\n",
    "        log(\"training Random Forest ...\")\n",
    "        t0 = time.time()\n",
    "        rf = fit_rf(XB[\"tr\"].fillna(-999), d_tr)\n",
    "        preds_te[\"Random Forest\"], preds_va[\"Random Forest\"] = rf.predict(XB[\"te\"].fillna(-999)), rf.predict(XB[\"va\"].fillna(-999))\n",
    "        models[\"Random Forest\"] = rf\n",
    "        log(f\"  RF done ({time.time()-t0:.0f}s)\")\n",
    "\n",
    "    preds_te[\"Blend (LightGBM+XGBoost)\"] = (preds_te[\"LightGBM\"] + preds_te[\"XGBoost\"]) / 2\n",
    "    preds_va[\"Blend (LightGBM+XGBoost)\"] = (preds_va[\"LightGBM\"] + preds_va[\"XGBoost\"]) / 2\n",
    "\n",
    "    val_rmse = {}\n",
    "    for name in preds_te:\n",
    "        rows[name] = reg_metrics(yte_lvl, base_te + preds_te[name], base_te)\n",
    "        val_rmse[name] = float(np.sqrt(mean_squared_error(yva_lvl, L0[va_m].values + preds_va[name])))\n",
    "    tab = pd.DataFrame(rows).T\n",
    "    tab[\"val_RMSE_m\"] = pd.Series(val_rmse)\n",
    "    tab.to_csv(out / \"model_comparison_test.csv\")\n",
    "    log(\"\\n\" + tab[[\"R2_level\", \"RMSE_m\", \"MAE_m\", \"within_1m_%\", \"R2_of_change\", \"skill_vs_persistence\", \"val_RMSE_m\"]].round(4).to_string())\n",
    "\n",
    "    # choose by VALIDATION RMSE (not by test)\n",
    "    best_name = min(val_rmse, key=val_rmse.get)\n",
    "    results[\"best_model_by_validation\"] = best_name\n",
    "    results[\"model_comparison_test\"] = tab.round(5).to_dict(\"index\")\n",
    "    log(f\"best on validation: {best_name}\")\n",
    "\n",
    "    # ---- rainfall ablation (LightGBM, identical settings) ----\n",
    "    log(\"rainfall ablation ...\")\n",
    "    abl = {}\n",
    "    for label, fs in [(\"Levels only (no rain)\", feats_A), (\"Levels + past rainfall\", feats_B),\n",
    "                      (\"Levels + past rain + rain in forecast window\", feats_C)]:\n",
    "        Xa = {k: f.loc[msk, fs].astype(\"float32\") for k, msk in zip([\"tr\", \"va\", \"te\"], [tr_m, va_m, te_m])}\n",
    "        ml = fit_lgb(Xa[\"tr\"], d_tr, Xa[\"va\"], d_va, cats)\n",
    "        pa = base_te + ml.predict(Xa[\"te\"])\n",
    "        abl[label] = reg_metrics(yte_lvl, pa, base_te)\n",
    "    abl = pd.DataFrame(abl).T\n",
    "    abl.to_csv(out / \"rainfall_ablation_test.csv\")\n",
    "    results[\"rainfall_ablation_test\"] = abl.round(5).to_dict(\"index\")\n",
    "    log(\"\\n\" + abl[[\"R2_level\", \"RMSE_m\", \"MAE_m\", \"within_1m_%\", \"R2_of_change\"]].round(4).to_string())\n",
    "\n",
    "    # ---- final model: refit best on train+validation ----\n",
    "    log(\"refitting the final model on train + validation ...\")\n",
    "    trva = tr_m | va_m\n",
    "    Xtv = f.loc[trva, feats_B].astype(\"float32\")\n",
    "    d_tv = y_all[trva].values\n",
    "    if best_name == \"Blend (LightGBM+XGBoost)\":\n",
    "        l2 = lgb.LGBMRegressor(n_estimators=lg.best_iteration_, n_jobs=1, random_state=SEED, verbose=-1,\n",
    "                               **LGB_PARAMS).fit(Xtv, d_tv, categorical_feature=cats)\n",
    "        x2 = xgb.XGBRegressor(n_estimators=xg.best_iteration + 1, learning_rate=0.05, max_depth=8, min_child_weight=5,\n",
    "                              subsample=0.8, colsample_bytree=0.8, tree_method=\"hist\", n_jobs=1,\n",
    "                              random_state=SEED).fit(Xtv, d_tv)\n",
    "        final_models = {\"lgb\": l2, \"xgb\": x2}\n",
    "        predict_delta = lambda X: (final_models[\"lgb\"].predict(X) + final_models[\"xgb\"].predict(X)) / 2\n",
    "    elif best_name == \"LightGBM\":\n",
    "        l2 = lgb.LGBMRegressor(n_estimators=lg.best_iteration_, n_jobs=1, random_state=SEED, verbose=-1,\n",
    "                               **LGB_PARAMS).fit(Xtv, d_tv, categorical_feature=cats)\n",
    "        final_models = {\"lgb\": l2}\n",
    "        predict_delta = lambda X: final_models[\"lgb\"].predict(X)\n",
    "    else:\n",
    "        final_models = {\"model\": models[best_name]}\n",
    "        predict_delta = lambda X: final_models[\"model\"].predict(X)\n",
    "    final_te = base_te + predict_delta(XB[\"te\"])\n",
    "    results[\"final_model_test\"] = {k: float(v) for k, v in reg_metrics(yte_lvl, final_te, base_te).items()}\n",
    "    log(f\"final model test: {results['final_model_test']}\")\n",
    "\n",
    "    # ---- prediction intervals: 10th and 90th percentile models (an 80% range) ----\n",
    "    log(\"fitting prediction-interval models ...\")\n",
    "    q_lo = fit_quantile(XB[\"tr\"], d_tr, XB[\"va\"], d_va, cats, 0.10)\n",
    "    q_hi = fit_quantile(XB[\"tr\"], d_tr, XB[\"va\"], d_va, cats, 0.90)\n",
    "    dte = predict_delta(XB[\"te\"])\n",
    "    lo_te = base_te + np.minimum(q_lo.predict(XB[\"te\"]), dte)\n",
    "    hi_te = base_te + np.maximum(q_hi.predict(XB[\"te\"]), dte)\n",
    "    results[\"prediction_interval_test\"] = {\n",
    "        \"nominal_coverage_%\": 80.0,\n",
    "        \"actual_coverage_%\": float(np.mean((yte_lvl >= lo_te) & (yte_lvl <= hi_te)) * 100),\n",
    "        \"mean_width_m\": float(np.mean(hi_te - lo_te)),\n",
    "        \"median_width_m\": float(np.median(hi_te - lo_te))}\n",
    "    log(f\"interval test: {results['prediction_interval_test']}\")\n",
    "    q_lo_f = fit_quantile(Xtv, d_tv, None, None, cats, 0.10, n_estimators=q_lo.best_iteration_)\n",
    "    q_hi_f = fit_quantile(Xtv, d_tv, None, None, cats, 0.90, n_estimators=q_hi.best_iteration_)\n",
    "\n",
    "    # ---- plots (regression) ----\n",
    "    plot_model_comparison(tab, out / \"01_model_comparison.png\")\n",
    "    plot_actual_vs_pred(yte_lvl, final_te, out / \"02_actual_vs_predicted.png\",\n",
    "                        f\"Final model ({best_name}) on the test period: R\\u00b2 = {results['final_model_test']['R2_level']:.4f}, \"\n",
    "                        f\"MAE = {results['final_model_test']['MAE_m']:.2f} m\")\n",
    "    plot_importance(lg, feats_B, out / \"03_feature_importance.png\")\n",
    "    plot_ablation(abl, out / \"04_rainfall_ablation.png\")\n",
    "\n",
    "    # ---- sustainability: accuracy of the model's class on the test period ----\n",
    "    log(\"sustainability trends (training period only, for honest evaluation) ...\")\n",
    "    tr_trend = station_trends(m, upto_mi=TRAIN_END)\n",
    "    sd_te, sl_te = attach_trend(f[te_m], tr_trend)\n",
    "    cls_true = sustainability_class(yte_lvl, sd_te, sl_te)\n",
    "    cls_pred = sustainability_class(final_te, sd_te, sl_te)\n",
    "    cm = confusion_matrix(cls_true, cls_pred, labels=CLASSES)\n",
    "    depth_true = np.select([yte_lvl >= DEPTH_CRITICAL, yte_lvl >= DEPTH_SAFE], [\"Critical\", \"Moderate\"], \"Safe\")\n",
    "    depth_pred = np.select([final_te >= DEPTH_CRITICAL, final_te >= DEPTH_SAFE], [\"Critical\", \"Moderate\"], \"Safe\")\n",
    "    cls_res = {\n",
    "        \"class_accuracy_%\": float(accuracy_score(cls_true, cls_pred) * 100),\n",
    "        \"balanced_accuracy_%\": float(balanced_accuracy_score(cls_true, cls_pred) * 100),\n",
    "        \"macro_F1\": float(f1_score(cls_true, cls_pred, average=\"macro\", labels=CLASSES)),\n",
    "        \"depth_band_accuracy_%\": float(accuracy_score(depth_true, depth_pred) * 100),\n",
    "        \"persistence_class_accuracy_%\": float(accuracy_score(cls_true, sustainability_class(base_te, sd_te, sl_te)) * 100),\n",
    "        \"test_class_share_%\": {c: float((cls_true == c).mean() * 100) for c in CLASSES},\n",
    "        \"confusion_matrix(rows=actual, cols=pred)\": cm.tolist(),\n",
    "    }\n",
    "    results[\"sustainability_class_test\"] = cls_res\n",
    "    log(f\"class accuracy: {cls_res}\")\n",
    "    plot_confusion(cm, out / \"05_confusion_matrix.png\", f\"Sustainability class (test)\\naccuracy {cls_res['class_accuracy_%']:.2f}%\")\n",
    "\n",
    "    # ---- class-probability model: how SURE are we about Safe / Moderate / Critical? ----\n",
    "    log(\"training the class-probability model ...\")\n",
    "    CLS_FEATURES = feats_B + [\"t_slope\", \"t_sig\", \"t_p\", \"t_nyears\"]\n",
    "    sd_all, sl_all = attach_trend(f, tr_trend)\n",
    "    tt = tr_trend.set_index(\"sid\")\n",
    "    fC = f[feats_B].astype(\"float32\").copy()\n",
    "    fC[\"t_slope\"], fC[\"t_sig\"] = sl_all, sd_all.astype(float)\n",
    "    fC[\"t_p\"], fC[\"t_nyears\"] = f.sid.map(tt.mk_p).values, f.sid.map(tt.n_years).values\n",
    "    cls_int = pd.Series(sustainability_class(f.y_next.fillna(0).values, sd_all, sl_all)).map(\n",
    "        {\"Safe\": 0, \"Moderate\": 1, \"Critical\": 2}).values\n",
    "    clf_kw = dict(objective=\"multiclass\", learning_rate=0.05, num_leaves=63, min_child_samples=40, subsample=0.8,\n",
    "                  subsample_freq=1, colsample_bytree=0.8, n_jobs=1, random_state=SEED, verbose=-1)\n",
    "    clf = lgb.LGBMClassifier(n_estimators=2000, **clf_kw)\n",
    "    clf.fit(fC.loc[tr_m, CLS_FEATURES], cls_int[tr_m.values], eval_set=[(fC.loc[va_m, CLS_FEATURES], cls_int[va_m.values])],\n",
    "            categorical_feature=cats, callbacks=[lgb.early_stopping(50, verbose=False)])\n",
    "    P_te = clf.predict_proba(fC.loc[te_m, CLS_FEATURES])\n",
    "    y_cls_te = cls_int[te_m.values]\n",
    "    clf_pred = P_te.argmax(1)\n",
    "    head_idx = np.array([CLASSES.index(c) for c in cls_pred])           # the headline class (rule on predicted level)\n",
    "    p_head = P_te[np.arange(len(P_te)), head_idx]\n",
    "    sel = []\n",
    "    for thr in (0.0, 0.6, 0.8, 0.9, 0.95, 0.99):\n",
    "        mk = p_head >= thr\n",
    "        sel.append({\"min_confidence\": thr, \"share_of_stations_%\": float(mk.mean() * 100),\n",
    "                    \"accuracy_%\": float((cls_pred[mk] == cls_true[mk]).mean() * 100)})\n",
    "    results[\"class_probability_model_test\"] = {\n",
    "        \"classifier_accuracy_%\": float(accuracy_score(y_cls_te, clf_pred) * 100),\n",
    "        \"classifier_balanced_accuracy_%\": float(balanced_accuracy_score(y_cls_te, clf_pred) * 100),\n",
    "        \"classifier_macro_F1\": float(f1_score(y_cls_te, clf_pred, average=\"macro\")),\n",
    "        \"headline_class_accuracy_by_confidence\": sel,\n",
    "    }\n",
    "    log(\"accuracy by confidence: \" + \"; \".join(f\"conf>={r['min_confidence']:.2f}: {r['accuracy_%']:.1f}% on {r['share_of_stations_%']:.0f}%\" for r in sel))\n",
    "    trva_mask = (tr_m | va_m).values\n",
    "    clf_f = lgb.LGBMClassifier(n_estimators=clf.best_iteration_, **clf_kw).fit(\n",
    "        fC.loc[trva_mask, CLS_FEATURES], cls_int[trva_mask], categorical_feature=cats)\n",
    "    del fC\n",
    "\n",
    "    # ---- sustainability: full observed period -> station + state-basin tables ----\n",
    "    log(\"sustainability trends (full period) ...\")\n",
    "    tr_full = station_trends(m)\n",
    "    last = m.sort_values([\"sid\", \"mi\"]).groupby(\"sid\").tail(4).groupby(\"sid\").agg(\n",
    "        recent_depth_m=(\"level\", \"mean\"), state=(\"state\", \"first\"), district=(\"district\", \"first\"),\n",
    "        station=(\"station\", \"first\"), basin=(\"basin\", \"first\"), lat=(\"lat\", \"first\"), lon=(\"lon\", \"first\"),\n",
    "        last_mi=(\"mi\", \"max\")).reset_index()\n",
    "    st = last.merge(tr_full, on=\"sid\", how=\"left\")\n",
    "    st[\"sig_decline\"] = st.sig_decline.fillna(False).astype(bool)\n",
    "    st[\"sen_slope_m_per_yr\"] = st.sen_slope_m_per_yr.fillna(0.0)\n",
    "    st[\"sustainability_class\"] = sustainability_class(st.recent_depth_m, st.sig_decline, st.sen_slope_m_per_yr)\n",
    "    st[\"last_reading\"] = pd.PeriodIndex.from_ordinals(st.last_mi.values, freq=\"M\").astype(str)\n",
    "    st[\"trend\"] = np.where(st.mk_p.isna(), \"insufficient data\",\n",
    "                   np.where(st.sig_decline, \"declining (significant)\",\n",
    "                   np.where(st.sig_recovery.fillna(False), \"recovering (significant)\", \"no significant trend\")))\n",
    "    st_out = st[[\"sid\", \"state\", \"district\", \"station\", \"basin\", \"lat\", \"lon\", \"last_reading\", \"recent_depth_m\",\n",
    "                 \"n_years\", \"sen_slope_m_per_yr\", \"mk_p\", \"trend\", \"sustainability_class\"]].rename(columns={\"sid\": \"station_id\"})\n",
    "    st_out.round(4).to_csv(out / \"station_sustainability.csv\", index=False)\n",
    "\n",
    "    g = st.groupby([\"state\", \"basin\"])\n",
    "    sb = g.agg(n_stations=(\"sid\", \"size\"), median_depth_m=(\"recent_depth_m\", \"median\"),\n",
    "               median_slope_m_per_yr=(\"sen_slope_m_per_yr\", \"median\"),\n",
    "               pct_declining=(\"sig_decline\", lambda s: s.mean() * 100),\n",
    "               n_critical=(\"sustainability_class\", lambda s: (s == \"Critical\").sum()),\n",
    "               n_moderate=(\"sustainability_class\", lambda s: (s == \"Moderate\").sum()),\n",
    "               n_safe=(\"sustainability_class\", lambda s: (s == \"Safe\").sum())).reset_index()\n",
    "    sb[\"pct_critical\"] = sb.n_critical / sb.n_stations * 100\n",
    "    sb[\"state_basin_class\"] = np.where(\n",
    "        (sb.pct_critical >= 25) | ((sb.median_slope_m_per_yr >= 0.3) & (sb.pct_declining >= 30)), \"Critical\",\n",
    "        np.where((sb.pct_critical < 10) & (sb.pct_declining < 15), \"Safe\", \"Moderate\"))\n",
    "    sb = sb[sb.n_stations >= 10].sort_values([\"state_basin_class\", \"pct_critical\"], ascending=[True, False])\n",
    "    sb.round(3).to_csv(out / \"state_basin_sustainability.csv\", index=False)\n",
    "    results[\"sustainability_summary\"] = {\n",
    "        \"stations_by_class\": st.sustainability_class.value_counts().to_dict(),\n",
    "        \"stations_with_trend_result\": int(st.mk_p.notna().sum()),\n",
    "        \"stations_declining_significant\": int(st.sig_decline.sum()),\n",
    "        \"stations_recovering_significant\": int(st.sig_recovery.fillna(False).sum()),\n",
    "        \"state_basin_groups\": sb.state_basin_class.value_counts().to_dict(),\n",
    "    }\n",
    "    log(f\"sustainability summary: {results['sustainability_summary']}\")\n",
    "    plot_map(st, out / \"06_sustainability_map.png\")\n",
    "    plot_state_bar(sb, out / \"07_state_sustainability_mix.png\")\n",
    "\n",
    "    # ---- next-reading forecast for every station ----\n",
    "    log(\"forecasting the next reading for each station ...\")\n",
    "    lastrow = f.sort_values([\"sid\", \"mi\"]).groupby(\"sid\").tail(1)\n",
    "    Xl = lastrow[feats_B].astype(\"float32\")\n",
    "    pl = lastrow.L0.values + predict_delta(Xl)\n",
    "    fc = pd.DataFrame({\"sid\": lastrow.sid.values, \"state\": lastrow.state.values, \"district\": lastrow.district.values,\n",
    "                       \"station\": lastrow.station.values, \"basin\": lastrow.basin.values,\n",
    "                       \"lat\": lastrow.lat.values, \"lon\": lastrow.lon.values,\n",
    "                       \"last_reading\": pd.PeriodIndex.from_ordinals(lastrow.mi.values, freq=\"M\").astype(str),\n",
    "                       \"last_level_m\": lastrow.L0.values,\n",
    "                       \"forecast_month\": pd.PeriodIndex.from_ordinals(lastrow.tgt_mi.values, freq=\"M\").astype(str),\n",
    "                       \"predicted_level_m\": np.clip(pl, 0, None),\n",
    "                       \"predicted_low_m\": np.clip(lastrow.L0.values + np.minimum(q_lo_f.predict(Xl), pl - lastrow.L0.values), 0, None),\n",
    "                       \"predicted_high_m\": np.clip(lastrow.L0.values + np.maximum(q_hi_f.predict(Xl), pl - lastrow.L0.values), 0, None)})\n",
    "    t = tr_full.set_index(\"sid\")\n",
    "    fc[\"sig_decline\"] = fc.sid.map(t.sig_decline).fillna(False).astype(bool)\n",
    "    fc[\"sen_slope_m_per_yr\"] = fc.sid.map(t.sen_slope_m_per_yr).fillna(0.0)\n",
    "    # explanations + confidence for every station\n",
    "    rule = {\"safe_below_m\": DEPTH_SAFE, \"critical_from_m\": DEPTH_CRITICAL, \"critical_slope_m_per_yr\": SLOPE_CRITICAL}\n",
    "    Xc = Xl.copy()\n",
    "    sd_l, sl_l = attach_trend(lastrow, tr_full)\n",
    "    Xc[\"t_slope\"], Xc[\"t_sig\"] = sl_l, sd_l.astype(float)\n",
    "    Xc[\"t_p\"], Xc[\"t_nyears\"] = lastrow.sid.map(t.mk_p).values, lastrow.sid.map(t.n_years).values\n",
    "    probs = clf_f.predict_proba(Xc[CLS_FEATURES])\n",
    "    booster = final_models[\"lgb\"].booster_ if \"lgb\" in final_models else lg.booster_\n",
    "    contrib = gx.group_contributions(booster, Xl, feats_B)\n",
    "    expl = gx.build_explanations(\n",
    "        lastrow[feats_B].reset_index(drop=True), contrib, fc.predicted_level_m.values, fc.predicted_low_m.values,\n",
    "        fc.predicted_high_m.values, fc.sig_decline.values, fc.sen_slope_m_per_yr.values,\n",
    "        lastrow.sid.map(t.mk_p).values, lastrow.sid.map(t.n_years).values,\n",
    "        lastrow.sid.map(t.sig_recovery).fillna(False).astype(bool).values, probs, True, rule)\n",
    "    assert (expl.predicted_class.values == sustainability_class(fc.predicted_level_m, fc.sig_decline, fc.sen_slope_m_per_yr)).all()\n",
    "    fc[\"predicted_sustainability_class\"] = expl.predicted_class.values\n",
    "    for c_ in [\"confidence_pct\", \"confidence_level\", \"prob_safe_pct\", \"prob_moderate_pct\", \"prob_critical_pct\", \"reliability\"]:\n",
    "        fc[c_] = expl[c_].values\n",
    "    fc.drop(columns=[\"sig_decline\"]).rename(columns={\"sid\": \"station_id\"}).round(3).to_csv(out / \"next_reading_forecast_all_stations.csv\", index=False)\n",
    "    ecols = [\"why_class\", \"how_close_to_next_class\", \"suggested_action\", \"why_forecast\", \"reliability_note\"] + \\\n",
    "            [c_ for c_ in expl.columns if c_.startswith(\"contrib_\")]\n",
    "    ex_out = expl[ecols].copy()\n",
    "    ex_out.insert(0, \"station_id\", fc.sid.values)\n",
    "    ex_out.to_csv(out / \"station_explanations.csv\", index=False)\n",
    "\n",
    "    # ---- save the model + metadata ----\n",
    "    maps = {\"state\": {k: int(v) for k, v in f.drop_duplicates(\"skey\").set_index(\"skey\").state_code.items()},\n",
    "            \"basin\": {k: int(v) for k, v in f.dropna(subset=[\"basin\"]).drop_duplicates(\"basin\").set_index(\"basin\").basin_code.items()}}\n",
    "    joblib.dump({\"models\": final_models, \"kind\": best_name, \"features\": feats_B, \"categorical\": cats,\n",
    "                 \"maps\": maps, \"interval_models\": {\"q10\": q_lo_f, \"q90\": q_hi_f}, \"lgb_params\": dict(LGB_PARAMS),\n",
    "                 \"class_model\": clf_f, \"class_features\": CLS_FEATURES,\n",
    "                 \"target\": \"next-reading depth minus current depth (m)\",\n",
    "                 \"split\": {\"train_end\": \"2018-12\", \"val\": \"2019\", \"test\": \"2020+\"},\n",
    "                 \"sustainability_rule\": {\"safe_below_m\": DEPTH_SAFE, \"critical_from_m\": DEPTH_CRITICAL,\n",
    "                                         \"critical_slope_m_per_yr\": SLOPE_CRITICAL}},\n",
    "                out / \"groundwater_model.joblib\")\n",
    "    with open(out / \"metrics.json\", \"w\") as fh:\n",
    "        json.dump(results, fh, indent=2, default=float)\n",
    "    log(\"DONE. Files written to \" + str(out.resolve()))\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
