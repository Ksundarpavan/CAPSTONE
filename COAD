   "source": [
    "%%writefile groundwater_forecaster.py\n",
    "#!/usr/bin/env python3\n",
    "\"\"\"\n",
    "Groundwater forecaster for typed-in values (with explainable AI)\n",
    "================================================================\n",
    "A user types in a few numbers about ONE station:\n",
    "\n",
    "    readings      the last 1-4 water-level readings (depth below ground in metres, oldest first, latest last)\n",
    "    month         the month of the latest reading (1-12)\n",
    "    months_ahead  how many months ahead to forecast (default: the next usual reading)\n",
    "    state         (optional) the state / UT\n",
    "    rain6_mm, rain6_pct_normal   (optional) state rainfall over the last 6 months\n",
    "    trend         (optional) the station's long-term trend, if known\n",
    "\n",
    "and gets back:\n",
    "\n",
    "    * the forecast water level and a likely range (80%)\n",
    "    * the Safe / Moderate / Critical class with the chance of each class\n",
    "    * WHY it got that class (the rule, step by step) and how close it is to the next class\n",
    "    * WHY the level is expected to move: exact group-level Shapley values (explainable AI) for\n",
    "      5 causes: current depth, recent change in the readings, season & timing, rainfall, state\n",
    "\n",
    "The model behind it is whichever of Random Forest / LightGBM / LSTM / BiLSTM / Transformer / Hybrid RF-LSTM\n",
    "won the comparison in groundwater_compare.py.\n",
    "\n",
    "    from groundwater_forecaster import GroundwaterForecaster\n",
    "    gf = GroundwaterForecaster(\"compare_outputs\")\n",
    "    out = gf.forecast(readings=[5.2, 5.9, 6.4, 7.1], month=11, state=\"Punjab\", months_ahead=3)\n",
    "\"\"\"\n",
    "import itertools\n",
    "import math\n",
    "from math import factorial\n",
    "from pathlib import Path\n",
    "\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "import groundwater_explainer as gx\n",
    "\n",
    "CLASSES = gx.CLASSES\n",
    "MON = gx.MON\n",
    "NEXT_MONTH = {1: 5, 5: 8, 8: 11, 11: 1}\n",
    "RAW_COLS = [\"L0\", \"d1\", \"d2\", \"d3\", \"n_readings\", \"gap_prev\", \"month_t\", \"horizon\", \"rain6\", \"dep6\", \"state_code\"]\n",
    "TAB_COLS = [\"L0\", \"d1\", \"d2\", \"d3\", \"n_readings\", \"gap_prev\", \"month_t\", \"month_tgt\", \"horizon\", \"rain6\", \"dep6\",\n",
    "            \"state_code\", \"L0_minus_mean4\"]\n",
    "N_STATIC = 11\n",
    "DELTA_SCALE = 3.0           # the neural networks predict (change in metres) / 3\n",
    "GROUPS = {\n",
    "    \"Current depth\": [\"L0\"],\n",
    "    \"Recent change in readings\": [\"d1\", \"d2\", \"d3\", \"n_readings\"],\n",
    "    \"Season & timing\": [\"month_t\", \"horizon\", \"gap_prev\"],\n",
    "    \"Rainfall\": [\"rain6\", \"dep6\"],\n",
    "    \"State\": [\"state_code\"],\n",
    "}\n",
    "TREND_OPTIONS = {\n",
    "    \"Not known\": dict(sig=False, slope=0.0, rec=False, n_years=np.nan, p=np.nan, text=None),\n",
    "    \"Stable (no clear change)\": dict(sig=False, slope=0.0, rec=False, n_years=10, p=0.5,\n",
    "                                     text=\"Long-term trend (as you entered): stable, no clear change.\"),\n",
    "    \"Declining slowly (under 0.5 m per year)\": dict(sig=True, slope=0.25, rec=False, n_years=10, p=0.01,\n",
    "                                                    text=\"Long-term trend (as you entered): getting deeper by less than 0.5 m per year.\"),\n",
    "    \"Declining fast (0.5 m per year or more)\": dict(sig=True, slope=0.75, rec=False, n_years=10, p=0.01,\n",
    "                                                    text=\"Long-term trend (as you entered): getting deeper by 0.5 m per year or more.\"),\n",
    "    \"Recovering (getting shallower)\": dict(sig=False, slope=-0.25, rec=True, n_years=10, p=0.01,\n",
    "                                           text=\"Long-term trend (as you entered): getting shallower (recovering).\"),\n",
    "}\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# Input handling and feature transforms (shared by training and prediction)\n",
    "# ----------------------------------------------------------------------------\n",
    "def default_months_ahead(month):\n",
    "    gap = (NEXT_MONTH.get(month, (month + 2) % 12 + 1) - month) % 12\n",
    "    return gap or 12\n",
    "\n",
    "\n",
    "def raw_from_readings(readings, month, months_ahead=None, gap_prev=3, rain6=np.nan, dep6=np.nan, state_code=np.nan):\n",
    "    \"\"\"Turn typed-in values into the model's compact input row (older readings are padded by repeating the oldest).\"\"\"\n",
    "    r = [float(x) for x in readings][-4:]\n",
    "    if not r:\n",
    "        raise ValueError(\"Please give at least one water-level reading.\")\n",
    "    n = len(r)\n",
    "    arr = [r[0]] * (4 - n) + r                    # oldest ... newest\n",
    "    L3, L2, L1, L0 = arr\n",
    "    month = int(month)\n",
    "    return {\"L0\": L0, \"d1\": L0 - L1, \"d2\": L1 - L2, \"d3\": L2 - L3, \"n_readings\": float(n),\n",
    "            \"gap_prev\": float(gap_prev), \"month_t\": float(month),\n",
    "            \"horizon\": float(months_ahead or default_months_ahead(month)),\n",
    "            \"rain6\": float(rain6), \"dep6\": float(dep6), \"state_code\": float(state_code)}\n",
    "\n",
    "\n",
    "def _levels(raw):\n",
    "    L0 = raw[\"L0\"].values.astype(float)\n",
    "    L1 = L0 - raw[\"d1\"].values\n",
    "    L2 = L1 - raw[\"d2\"].values\n",
    "    L3 = L2 - raw[\"d3\"].values\n",
    "    return L0, L1, L2, L3\n",
    "\n",
    "\n",
    "def tab_features(raw):\n",
    "    \"\"\"Table features for Random Forest and LightGBM.\"\"\"\n",
    "    L0, L1, L2, L3 = _levels(raw)\n",
    "    month_tgt = (raw[\"month_t\"].values - 1 + raw[\"horizon\"].values) % 12 + 1\n",
    "    return pd.DataFrame({\n",
    "        \"L0\": L0, \"d1\": raw[\"d1\"].values, \"d2\": raw[\"d2\"].values, \"d3\": raw[\"d3\"].values,\n",
    "        \"n_readings\": raw[\"n_readings\"].values, \"gap_prev\": raw[\"gap_prev\"].values, \"month_t\": raw[\"month_t\"].values,\n",
    "        \"month_tgt\": month_tgt, \"horizon\": raw[\"horizon\"].values, \"rain6\": raw[\"rain6\"].values,\n",
    "        \"dep6\": raw[\"dep6\"].values, \"state_code\": raw[\"state_code\"].values,\n",
    "        \"L0_minus_mean4\": L0 - (L0 + L1 + L2 + L3) / 4}, columns=TAB_COLS)\n",
    "\n",
    "\n",
    "def nn_inputs(raw, rf_delta=None):\n",
    "    \"\"\"Arrays for the LSTM / BiLSTM / Transformer / Hybrid networks.\"\"\"\n",
    "    n = len(raw)\n",
    "    L0, L1, L2, L3 = _levels(raw)\n",
    "    levels = np.stack([L3, L2, L1, L0], axis=1)                              # oldest -> newest\n",
    "    lg = np.log1p(np.clip(levels, 0, None)) / 6.0\n",
    "    rel = np.clip((levels - L0[:, None]) / 10.0, -3, 3)\n",
    "    pos = np.broadcast_to(np.eye(4, dtype=\"float32\"), (n, 4, 4))\n",
    "    seq = np.concatenate([lg[..., None], rel[..., None], pos], axis=2).astype(\"float32\")\n",
    "    mt = raw[\"month_t\"].values\n",
    "    mg = (mt - 1 + raw[\"horizon\"].values) % 12 + 1\n",
    "    rain, dep = raw[\"rain6\"].values, raw[\"dep6\"].values\n",
    "    miss = (np.isnan(rain) | np.isnan(dep)).astype(\"float32\")\n",
    "    static = np.stack([\n",
    "        np.sin(2 * np.pi * mt / 12), np.cos(2 * np.pi * mt / 12), np.sin(2 * np.pi * mg / 12), np.cos(2 * np.pi * mg / 12),\n",
    "        raw[\"horizon\"].values / 6.0, raw[\"gap_prev\"].values / 6.0,\n",
    "        np.log1p(np.nan_to_num(rain, nan=0.0)) / 8.0, np.clip(np.nan_to_num(dep, nan=0.0), 0, 3) / 3.0, miss,\n",
    "        raw[\"n_readings\"].values / 4.0, np.log1p(np.clip(L0, 0, None)) / 6.0], axis=1).astype(\"float32\")\n",
    "    sc = raw[\"state_code\"].values\n",
    "    state_idx = np.where(np.isnan(sc), 0, sc + 1).astype(\"int32\")\n",
    "    out = {\"seq\": seq, \"static\": static, \"state\": state_idx}\n",
    "    if rf_delta is not None:\n",
    "        out[\"rf\"] = (np.asarray(rf_delta, dtype=\"float32\") / DELTA_SCALE).reshape(-1, 1)\n",
    "    return out\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# Exact group-level Shapley values (explainable AI that works for ANY model)\n",
    "# ----------------------------------------------------------------------------\n",
    "def group_shapley(delta_fn, X, background):\n",
    "    \"\"\"\n",
    "    delta_fn   : function(raw DataFrame) -> predicted change in metres\n",
    "    X          : DataFrame of n inputs (RAW_COLS)\n",
    "    background : DataFrame of B reference inputs (typical training rows)\n",
    "    returns    : phi (n x 5 effect of each group, metres), base (n,) typical change, fx (n,) the prediction\n",
    "    A coalition keeps the groups in S from the user's input and takes the other groups from the background rows;\n",
    "    its value is the average prediction. With 5 groups every one of the 32 coalitions is evaluated, so the result\n",
    "    is the exact Shapley value and  base + sum(phi) = prediction.\n",
    "    \"\"\"\n",
    "    names = list(GROUPS)\n",
    "    G = len(names)\n",
    "    cols = list(RAW_COLS)\n",
    "    subsets = list(itertools.product([0, 1], repeat=G))\n",
    "    mask = np.zeros((len(subsets), len(cols)), dtype=bool)\n",
    "    for si, s in enumerate(subsets):\n",
    "        for gi, flag in enumerate(s):\n",
    "            if flag:\n",
    "                for c in GROUPS[names[gi]]:\n",
    "                    mask[si, cols.index(c)] = True\n",
    "    x = X[cols].values.astype(float)\n",
    "    bg = background[cols].values.astype(float)\n",
    "    n, B = len(x), len(bg)\n",
    "    out = np.empty((n, len(subsets)))\n",
    "    step = max(1, 20000 // (len(subsets) * B))\n",
    "    for a in range(0, n, step):\n",
    "        xs = x[a:a + step]\n",
    "        big = np.where(mask[None, :, None, :], xs[:, None, None, :], bg[None, None, :, :])\n",
    "        pred = delta_fn(pd.DataFrame(big.reshape(-1, len(cols)), columns=cols))\n",
    "        out[a:a + step] = pred.reshape(len(xs), len(subsets), B).mean(axis=2)\n",
    "    index = {s: i for i, s in enumerate(subsets)}\n",
    "    phi = np.zeros((n, G))\n",
    "    for gi in range(G):\n",
    "        for s in subsets:\n",
    "            if s[gi] == 0:\n",
    "                s2 = list(s)\n",
    "                s2[gi] = 1\n",
    "                k = sum(s)\n",
    "                w = factorial(k) * factorial(G - k - 1) / factorial(G)\n",
    "                phi[:, gi] += w * (out[:, index[tuple(s2)]] - out[:, index[s]])\n",
    "    return phi, out[:, index[(0,) * G]], out[:, index[(1,) * G]]\n",
    "\n",
    "\n",
    "def predictive_distribution(edges, q, rule, pred_level, sig, slope):\n",
    "    \"\"\"\n",
    "    Turn a point forecast into a range and class probabilities.\n",
    "    q holds 99 residual quantiles (1%..99%) of the validation errors for each depth band, so the range and the\n",
    "    probabilities are as wide as the model's real past errors at that depth.\n",
    "    \"\"\"\n",
    "    pred_level = np.atleast_1d(np.asarray(pred_level, float))\n",
    "    band = np.clip(np.searchsorted(edges, pred_level, side=\"right\") - 1, 0, len(q) - 1)\n",
    "    depths = np.clip(pred_level[:, None] + q[band], 0, None)                      # (n, 99)\n",
    "    sig = np.broadcast_to(np.asarray(sig, bool), pred_level.shape)\n",
    "    slope = np.broadcast_to(np.asarray(slope, float), pred_level.shape)\n",
    "    cls = gx.classify(depths, sig[:, None], slope[:, None], rule)\n",
    "    probs = np.stack([(cls == c).mean(axis=1) for c in CLASSES], axis=1)\n",
    "    lo = np.clip(pred_level + q[band][:, 9], 0, None)\n",
    "    hi = np.clip(pred_level + q[band][:, 89], 0, None)\n",
    "    return lo, hi, probs\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# The forecaster\n",
    "# ----------------------------------------------------------------------------\n",
    "class GroundwaterForecaster:\n",
    "    def __init__(self, folder=\"compare_outputs\"):\n",
    "        self.folder = Path(folder)\n",
    "        self.bundle = joblib.load(self.folder / \"forecaster_bundle.joblib\")\n",
    "        self.kind = self.bundle[\"kind\"]\n",
    "        self.rule = self.bundle[\"rule\"]\n",
    "        self.states = self.bundle[\"state_codes\"]                 # {\"Punjab\": 28, ...}\n",
    "        self.background = pd.DataFrame(self.bundle[\"background\"])[RAW_COLS]\n",
    "        self._rf = self._tab = self._nn = None\n",
    "        if self.kind in (\"Random Forest\", \"Hybrid RF-LSTM\"):\n",
    "            self._rf = joblib.load(self.folder / \"rf_model.joblib\")\n",
    "        if self.kind == \"LightGBM\":\n",
    "            self._tab = joblib.load(self.folder / \"lgbm_model.joblib\")\n",
    "        if self.kind in (\"LSTM\", \"BiLSTM\", \"Transformer\", \"Hybrid RF-LSTM\"):\n",
    "            import keras\n",
    "            self._nn = keras.saving.load_model(self.folder / \"best_nn.keras\", compile=False)\n",
    "\n",
    "    # -- prediction of the change in metres ------------------------------------\n",
    "    def delta(self, raw):\n",
    "        raw = raw[RAW_COLS]\n",
    "        if self.kind == \"Random Forest\":\n",
    "            return self._rf.predict(tab_features(raw).fillna(-1))\n",
    "        if self.kind == \"LightGBM\":\n",
    "            return self._tab.predict(tab_features(raw))\n",
    "        rf_delta = self._rf.predict(tab_features(raw).fillna(-1)) if self.kind == \"Hybrid RF-LSTM\" else None\n",
    "        return self._nn.predict(nn_inputs(raw, rf_delta), batch_size=4096, verbose=0)[:, 0] * DELTA_SCALE\n",
    "\n",
    "    # -- predictive distribution from validation residuals ----------------------\n",
    "    def predictive(self, pred_level, sig, slope):\n",
    "        return predictive_distribution(self.bundle[\"resid_edges\"], self.bundle[\"resid_q\"], self.rule,\n",
    "                                       pred_level, sig, slope)\n",
    "\n",
    "    # -- the user-facing call ---------------------------------------------------\n",
    "    def forecast(self, readings, month, months_ahead=None, state=None, rain6_mm=None, rain6_pct_normal=None,\n",
    "                 trend=\"Not known\", gap_prev=3, explain=True):\n",
    "        code = self.states.get(state, np.nan) if state else np.nan\n",
    "        rain6 = np.nan if rain6_mm is None else float(rain6_mm)\n",
    "        dep6 = np.nan if rain6_pct_normal is None else float(rain6_pct_normal) / 100.0\n",
    "        row = raw_from_readings(readings, month, months_ahead, gap_prev, rain6, dep6, code)\n",
    "        X = pd.DataFrame([row])[RAW_COLS]\n",
    "        d = float(self.delta(X)[0])\n",
    "        L0 = row[\"L0\"]\n",
    "        pred = max(0.0, L0 + d)\n",
    "        t = TREND_OPTIONS[trend]\n",
    "        lo, hi, probs = self.predictive(pred, t[\"sig\"], t[\"slope\"])\n",
    "        lo, hi, probs = float(lo[0]), float(hi[0]), probs[0]\n",
    "        cls = str(gx.classify(pred, t[\"sig\"], t[\"slope\"], self.rule))\n",
    "        cls_lo, cls_hi = str(gx.classify(lo, t[\"sig\"], t[\"slope\"], self.rule)), str(gx.classify(hi, t[\"sig\"], t[\"slope\"], self.rule))\n",
    "        p_head = float(probs[CLASSES.index(cls)])\n",
    "\n",
    "        why = gx._why_class(cls, pred, t[\"sig\"], t[\"rec\"], t[\"slope\"], t[\"p\"], t[\"n_years\"], self.rule)\n",
    "        if t[\"text\"]:\n",
    "            why[1] = t[\"text\"]\n",
    "        elif trend == \"Not known\":\n",
    "            why[1] = \"Long-term trend: not given, so only the water depth was used to decide the class.\"\n",
    "            if cls == \"Safe\":\n",
    "                why[2] = f\"Safe because the water is shallow (under {self.rule['safe_below_m']:.0f} m); no long-term trend was given, so none was assumed.\"\n",
    "        close = gx._how_close(cls, pred, t[\"sig\"], t[\"slope\"], lo, hi, self.rule)\n",
    "        crossing = sorted({cls_lo, cls_hi} - {cls}, key=CLASSES.index)\n",
    "        if crossing:\n",
    "            close += (f\" The likely range ({lo:.1f}-{hi:.1f} m) reaches into {' and '.join(crossing)}, \"\n",
    "                      \"so this station is close to a class boundary.\")\n",
    "\n",
    "        n_read = int(row[\"n_readings\"])\n",
    "        missing = []\n",
    "        if n_read < 4:\n",
    "            missing.append(f\"only {n_read} reading(s) given\")\n",
    "        if np.isnan(rain6):\n",
    "            missing.append(\"no rainfall given\")\n",
    "        if np.isnan(code):\n",
    "            missing.append(\"state not given\")\n",
    "        score = (2 if n_read >= 4 else 1 if n_read == 3 else 0) + (0 if np.isnan(rain6) else 1) + (0 if np.isnan(code) else 1)\n",
    "        reliability = \"High\" if score >= 4 else \"Medium\" if score >= 2 else \"Low\"\n",
    "        note = \"All inputs were given.\" if not missing else \"Less certain because \" + \", \".join(missing) + \".\"\n",
    "\n",
    "        out = {\"model\": self.kind, \"predicted_level_m\": pred, \"low_m\": lo, \"high_m\": hi, \"current_level_m\": L0,\n",
    "               \"expected_change_m\": pred - L0, \"predicted_class\": cls, \"current_class\": str(gx.classify(L0, t[\"sig\"], t[\"slope\"], self.rule)),\n",
    "               \"prob_safe_pct\": 100 * probs[0], \"prob_moderate_pct\": 100 * probs[1], \"prob_critical_pct\": 100 * probs[2],\n",
    "               \"confidence_pct\": 100 * p_head, \"confidence_level\": gx.confidence_label(p_head),\n",
    "               \"why_class\": why, \"how_close\": close, \"suggested_action\": gx.ACTIONS[cls],\n",
    "               \"reliability\": reliability, \"reliability_note\": note, \"inputs\": row}\n",
    "        if explain:\n",
    "            phi, base, fx = group_shapley(self.delta, X, self.background)\n",
    "            out[\"driver_effects_m\"] = {g: float(v) for g, v in zip(GROUPS, phi[0])}\n",
    "            out[\"typical_change_m\"] = float(base[0])\n",
    "            out[\"why_forecast\"] = self._driver_sentences(out, row, state, d, phi[0])\n",
    "        return out\n",
    "\n",
    "    def _driver_sentences(self, out, row, state, delta, phi):\n",
    "        names = list(GROUPS)\n",
    "        parts = [f\"Expected change: {delta:+.2f} m ({'deeper' if delta > 0 else 'shallower'}), from \"\n",
    "                 f\"{out['current_level_m']:.2f} m to {out['predicted_level_m']:.2f} m.\"]\n",
    "        used = 0\n",
    "        for gi in np.argsort(-np.abs(phi)):\n",
    "            c, g = float(phi[gi]), names[gi]\n",
    "            if abs(c) < 0.10 or used >= 3:\n",
    "                continue\n",
    "            used += 1\n",
    "            mt, hz = int(row[\"month_t\"]), int(row[\"horizon\"])\n",
    "            tgt = (mt - 1 + hz) % 12 + 1\n",
    "            if g == \"Season & timing\":\n",
    "                parts.append(f\"{c:+.2f} m from the season: the usual movement between {MON[mt - 1]} and {MON[tgt - 1]}.\")\n",
    "            elif g == \"Rainfall\":\n",
    "                if np.isnan(row[\"dep6\"]):\n",
    "                    parts.append(f\"{c:+.2f} m linked to rainfall (no rainfall was given, so an average year is assumed).\")\n",
    "                else:\n",
    "                    parts.append(f\"{c:+.2f} m linked to rainfall (the last 6 months had {row['dep6'] * 100:.0f}% of normal rain; \"\n",
    "                                 \"the effect also depends on the season).\")\n",
    "            elif g == \"Recent change in readings\":\n",
    "                parts.append(f\"{c:+.2f} m from the recent readings (the last change was {row['d1']:+.2f} m).\")\n",
    "            elif g == \"Current depth\":\n",
    "                parts.append(f\"{c:+.2f} m linked to the current depth ({row['L0']:.1f} m): stations at this depth tend to move differently.\")\n",
    "            else:\n",
    "                parts.append(f\"{c:+.2f} m from the typical pattern of {state if state else 'the state'}.\")\n",
    "        if used == 0:\n",
    "            parts.append(\"No single factor dominates; the change is small.\")\n",
    "        parts.append(f\"(For an average input the model expects {out['typical_change_m']:+.2f} m; the factors above explain the difference.)\")\n",
    "        return parts"
   ]
