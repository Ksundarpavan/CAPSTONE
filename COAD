   "source": [
    "%%writefile groundwater_compare.py\n",
    "#!/usr/bin/env python3\n",
    "\"\"\"\n",
    "Compare Random Forest, LSTM, BiLSTM, Hybrid RF-LSTM (+ Transformer and LightGBM as modern challengers)\n",
    "======================================================================================================\n",
    "All six models get exactly the same inputs - the values a user can type in:\n",
    "    the last 1-4 readings, month, months ahead, optional state, optional 6-month rainfall.\n",
    "They predict the CHANGE in water level (metres) at the station's next reading.\n",
    "\n",
    "Fair test: time-based split (train: targets up to 2018, validation: 2019, test: 2020 onwards).\n",
    "The winner is chosen on the VALIDATION data only and then reported once on the TEST data.\n",
    "\n",
    "The winning model is saved with its explainer, so groundwater_forecaster.py can answer a typed-in question:\n",
    "forecast, range, Safe / Moderate / Critical class with probabilities, and a step-by-step explanation.\n",
    "\n",
    "Usage:\n",
    "    python groundwater_compare.py --levels <cgwb.csv> --rain <rainfall.csv> --out compare_outputs\n",
    "    python groundwater_compare.py ... --quick        # 12% of the data, 3 epochs: a fast smoke test\n",
    "\"\"\"\n",
    "import argparse\n",
    "import json\n",
    "import os\n",
    "import time\n",
    "import warnings\n",
    "\n",
    "os.environ.setdefault(\"TF_CPP_MIN_LOG_LEVEL\", \"2\")\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import joblib\n",
    "import lightgbm as lgb\n",
    "import matplotlib\n",
    "\n",
    "matplotlib.use(\"Agg\")\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.model_selection import GroupKFold\n",
    "\n",
    "import groundwater_forecaster as gf\n",
    "import groundwater_pipeline as gp\n",
    "\n",
    "SEED = 42\n",
    "RULE = {\"safe_below_m\": gp.DEPTH_SAFE, \"critical_from_m\": gp.DEPTH_CRITICAL, \"critical_slope_m_per_yr\": gp.SLOPE_CRITICAL}\n",
    "NN_KINDS = [\"LSTM\", \"BiLSTM\", \"Transformer\", \"Hybrid RF-LSTM\"]\n",
    "\n",
    "\n",
    "def log(msg):\n",
    "    print(f\"[{time.strftime('%H:%M:%S')}] {msg}\", flush=True)\n",
    "\n",
    "\n",
    "def make_raw(f):\n",
    "    \"\"\"The compact inputs a user can type in, built from the pipeline's feature table.\"\"\"\n",
    "    return pd.DataFrame({\n",
    "        \"L0\": f.L0.values,\n",
    "        \"d1\": (f.L0 - f.L1).fillna(0).values, \"d2\": (f.L1 - f.L2).fillna(0).values, \"d3\": (f.L2 - f.L3).fillna(0).values,\n",
    "        \"n_readings\": np.minimum(f.n_hist.values, 4).astype(float),\n",
    "        \"gap_prev\": f.gap_prev.fillna(3).clip(1, 12).values, \"month_t\": f.month_t.values.astype(float),\n",
    "        \"horizon\": f.horizon.values.astype(float), \"rain6\": f.rain6.values, \"dep6\": f.dep6.values,\n",
    "        \"state_code\": f.state_code.astype(float).values})[gf.RAW_COLS]\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# Checkpoints: every finished model is saved, so a stopped run can simply be started again\n",
    "# ----------------------------------------------------------------------------\n",
    "def _ck(cache, name):\n",
    "    return cache / (name.replace(\" \", \"_\").replace(\"-\", \"_\") + \".npz\")\n",
    "\n",
    "\n",
    "def save_ck(cache, name, va, te, fit, params, curve=None):\n",
    "    np.savez(_ck(cache, name), va=va, te=te, fit=fit, params=params, curve=np.array(curve if curve else [], dtype=float))\n",
    "\n",
    "\n",
    "def load_ck(cache, name):\n",
    "    z = np.load(_ck(cache, name))\n",
    "    return z[\"va\"], z[\"te\"], float(z[\"fit\"]), int(z[\"params\"]), [float(x) for x in z[\"curve\"]]\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# Models\n",
    "# ----------------------------------------------------------------------------\n",
    "def new_rf(quick):\n",
    "    return RandomForestRegressor(n_estimators=40 if quick else 80, max_depth=16, min_samples_leaf=15, max_features=0.7,\n",
    "                                 max_samples=0.15, n_jobs=-1, random_state=SEED)\n",
    "\n",
    "\n",
    "def build_nn(kind, n_states):\n",
    "    import keras\n",
    "    from keras import layers\n",
    "    keras.utils.set_random_seed(SEED)\n",
    "    seq_in = keras.Input((4, 6), name=\"seq\")\n",
    "    st_in = keras.Input((gf.N_STATIC,), name=\"static\")\n",
    "    state_in = keras.Input((1,), dtype=\"int32\", name=\"state\")\n",
    "    inputs = [seq_in, st_in, state_in]\n",
    "    if kind == \"LSTM\":\n",
    "        h = layers.LSTM(48)(seq_in)\n",
    "    elif kind == \"BiLSTM\":\n",
    "        h = layers.Bidirectional(layers.LSTM(32))(seq_in)\n",
    "    elif kind == \"Transformer\":\n",
    "        x = layers.Dense(32)(seq_in)\n",
    "        for _ in range(2):\n",
    "            a = layers.MultiHeadAttention(num_heads=4, key_dim=8)(x, x)\n",
    "            x = layers.LayerNormalization()(x + a)\n",
    "            ff = layers.Dense(32)(layers.Dense(64, activation=\"relu\")(x))\n",
    "            x = layers.LayerNormalization()(x + ff)\n",
    "        h = layers.GlobalAveragePooling1D()(x)\n",
    "    else:                                                      # Hybrid RF-LSTM\n",
    "        h = layers.LSTM(48)(seq_in)\n",
    "    emb = layers.Flatten()(layers.Embedding(n_states + 1, 6)(state_in))\n",
    "    parts = [h, layers.Dense(32, activation=\"relu\")(st_in), emb]\n",
    "    if kind == \"Hybrid RF-LSTM\":\n",
    "        rf_in = keras.Input((1,), name=\"rf\")\n",
    "        inputs.append(rf_in)\n",
    "        parts.append(rf_in)\n",
    "    z = layers.Dense(64, activation=\"relu\")(layers.Concatenate()(parts))\n",
    "    z = layers.Dense(32, activation=\"relu\")(z)\n",
    "    if kind == \"Hybrid RF-LSTM\":                               # the network only learns a CORRECTION to the forest\n",
    "        out = layers.Add()([rf_in, layers.Dense(1, kernel_initializer=\"zeros\")(z)])\n",
    "    else:\n",
    "        out = layers.Dense(1)(z)\n",
    "    model = keras.Model(inputs, out, name=kind.replace(\" \", \"_\"))\n",
    "    model.compile(optimizer=keras.optimizers.Adam(2e-3), loss=\"mse\")\n",
    "    return model\n",
    "\n",
    "\n",
    "def train_nn(kind, tr_in, ytr, va_in, yva, n_states, epochs):\n",
    "    import keras\n",
    "    model = build_nn(kind, n_states)\n",
    "    cb = [keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=3, restore_best_weights=True),\n",
    "          keras.callbacks.ReduceLROnPlateau(factor=0.5, patience=1, min_lr=1e-4)]\n",
    "    hist = model.fit(tr_in, ytr / gf.DELTA_SCALE, validation_data=(va_in, yva / gf.DELTA_SCALE), epochs=epochs,\n",
    "                     batch_size=1024, verbose=2, callbacks=cb)\n",
    "    return model, hist.history[\"val_loss\"]\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# Charts\n",
    "# ----------------------------------------------------------------------------\n",
    "def chart_models(tab, best, path):\n",
    "    t = tab.sort_values(\"RMSE_m\", ascending=False)\n",
    "    cols = [\"#1565C0\" if i == best else (\"#B0BEC5\" if i.startswith(\"Persistence\") else \"#78909C\") for i in t.index]\n",
    "    fig, ax = plt.subplots(1, 3, figsize=(14, 4))\n",
    "    for a, met, title in zip(ax, [\"RMSE_m\", \"MAE_m\", \"R2_level\"], [\"Test RMSE (m), lower is better\", \"Test MAE (m), lower is better\", \"Test R\\u00b2, higher is better\"]):\n",
    "        a.barh(t.index, t[met], color=cols)\n",
    "        a.set_title(title, fontsize=10)\n",
    "        for y, v in enumerate(t[met]):\n",
    "            a.text(v, y, f\" {v:.3f}\", va=\"center\", fontsize=8)\n",
    "        if met == \"R2_level\":\n",
    "            a.set_xlim(max(0, t[met].min() - 0.03), 1.0)\n",
    "        if a is not ax[0]:\n",
    "            a.set_yticklabels([])\n",
    "    plt.suptitle(f\"Model comparison on the TEST period (2020 onwards). Selected on validation data: {best}\", fontsize=11)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def chart_best(y, p, name, path):\n",
    "    fig, ax = plt.subplots(1, 2, figsize=(11, 4.6))\n",
    "    ax[0].hexbin(y, p, gridsize=70, extent=(0, 40, 0, 40), bins=\"log\", cmap=\"viridis\", mincnt=1)\n",
    "    ax[0].plot([0, 40], [0, 40], \"r--\", lw=1)\n",
    "    ax[0].set_xlabel(\"Actual depth to water (m)\")\n",
    "    ax[0].set_ylabel(\"Predicted depth to water (m)\")\n",
    "    ax[0].set_title(\"Actual vs predicted (0-40 m)\")\n",
    "    ax[1].hist(np.clip(p - y, -6, 6), bins=120, color=\"#1565C0\")\n",
    "    ax[1].axvline(0, color=\"r\", lw=1)\n",
    "    ax[1].set_xlabel(\"Prediction error (m), clipped at \\u00b16 m\")\n",
    "    ax[1].set_title(\"Error distribution\")\n",
    "    plt.suptitle(f\"Selected model: {name}\", fontsize=11)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def chart_importance(imp, path):\n",
    "    imp = imp.sort_values()\n",
    "    fig, ax = plt.subplots(figsize=(7, 3.6))\n",
    "    ax.barh(imp.index, imp.values, color=\"#2E7D32\")\n",
    "    ax.set_xlabel(\"Average effect on the forecast (metres, ignoring direction)\")\n",
    "    ax.set_title(\"What drives the forecast (exact Shapley values, 250 test cases)\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "def chart_curves(curves, path):\n",
    "    fig, ax = plt.subplots(figsize=(6.5, 4))\n",
    "    for k, v in curves.items():\n",
    "        ax.plot(range(1, len(v) + 1), v, marker=\"o\", label=k)\n",
    "    ax.set_xlabel(\"Epoch\")\n",
    "    ax.set_ylabel(\"Validation loss (scaled MSE)\")\n",
    "    ax.set_title(\"Deep-learning models: validation loss\")\n",
    "    ax.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(path, dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "def main():\n",
    "    ap = argparse.ArgumentParser()\n",
    "    ap.add_argument(\"--levels\", default=\"cgwb-changes-in-depth-to-water-level_datase_1.csv\")\n",
    "    ap.add_argument(\"--rain\", default=\"daily-rainfall-at-state-level.csv\")\n",
    "    ap.add_argument(\"--out\", default=\"compare_outputs\")\n",
    "    ap.add_argument(\"--epochs\", type=int, default=12)\n",
    "    ap.add_argument(\"--quick\", action=\"store_true\", help=\"12%% of the training rows and 3 epochs (smoke test)\")\n",
    "    ap.add_argument(\"--fresh\", action=\"store_true\", help=\"ignore saved checkpoints and train everything again\")\n",
    "    args = ap.parse_args()\n",
    "    out = Path(args.out)\n",
    "    out.mkdir(parents=True, exist_ok=True)\n",
    "    cache = out / \"_checkpoints\"\n",
    "    cache.mkdir(exist_ok=True)\n",
    "    if args.fresh:\n",
    "        for fp in cache.glob(\"*\"):\n",
    "            fp.unlink()\n",
    "    epochs = 3 if args.quick else args.epochs\n",
    "\n",
    "    # ---- data ----\n",
    "    m, info = gp.load_levels(args.levels)\n",
    "    rain = gp.load_rain(args.rain)\n",
    "    f = gp.build_features(m, rain)\n",
    "    trm, vam, tem = gp.split_masks(f)\n",
    "    raw_all = make_raw(f)\n",
    "    delta_all = (f.y_next - f.L0).values\n",
    "    rng = np.random.RandomState(SEED)\n",
    "    tr_idx, va_idx, te_idx = (np.flatnonzero(x.values) for x in (trm, vam, tem))\n",
    "    if args.quick:\n",
    "        tr_idx = np.sort(rng.choice(tr_idx, size=int(len(tr_idx) * 0.12), replace=False))\n",
    "    R = {k: raw_all.iloc[i].reset_index(drop=True) for k, i in zip([\"tr\", \"va\", \"te\"], [tr_idx, va_idx, te_idx])}\n",
    "    D = {k: delta_all[i] for k, i in zip([\"tr\", \"va\", \"te\"], [tr_idx, va_idx, te_idx])}\n",
    "    L0 = {k: R[k].L0.values for k in R}\n",
    "    y_te = L0[\"te\"] + D[\"te\"]\n",
    "    n_states = int(f.state_code.max()) + 1\n",
    "    log(f\"rows: train {len(tr_idx):,} | validation {len(va_idx):,} | test {len(te_idx):,}\")\n",
    "\n",
    "    val_pred, te_pred, fit_s, n_params, curves = {}, {}, {}, {}, {}\n",
    "\n",
    "    # ---- Random Forest (also the base of the hybrid) ----\n",
    "    Xtab = {k: gf.tab_features(R[k]).fillna(-1) for k in R}\n",
    "    if _ck(cache, \"Random Forest\").exists() and (cache / \"rf.joblib\").exists():\n",
    "        log(\"Random Forest: loaded from checkpoint\")\n",
    "        rf = joblib.load(cache / \"rf.joblib\")\n",
    "        rf_va, rf_te, fit_s[\"Random Forest\"], n_params[\"Random Forest\"], _ = load_ck(cache, \"Random Forest\")\n",
    "    else:\n",
    "        log(\"Random Forest ...\")\n",
    "        t0 = time.time()\n",
    "        rf = new_rf(args.quick).fit(Xtab[\"tr\"], D[\"tr\"])\n",
    "        rf_va, rf_te = rf.predict(Xtab[\"va\"]), rf.predict(Xtab[\"te\"])\n",
    "        fit_s[\"Random Forest\"] = time.time() - t0\n",
    "        n_params[\"Random Forest\"] = int(sum(t.tree_.node_count for t in rf.estimators_))\n",
    "        joblib.dump(rf, cache / \"rf.joblib\", compress=3)\n",
    "        save_ck(cache, \"Random Forest\", rf_va, rf_te, fit_s[\"Random Forest\"], n_params[\"Random Forest\"])\n",
    "    val_pred[\"Random Forest\"], te_pred[\"Random Forest\"] = rf_va, rf_te\n",
    "\n",
    "    # ---- LightGBM (modern gradient boosting) ----\n",
    "    Xl = {k: gf.tab_features(R[k]) for k in R}\n",
    "    if _ck(cache, \"LightGBM\").exists() and (cache / \"lgbm.joblib\").exists():\n",
    "        log(\"LightGBM: loaded from checkpoint\")\n",
    "        lg = joblib.load(cache / \"lgbm.joblib\")\n",
    "        val_pred[\"LightGBM\"], te_pred[\"LightGBM\"], fit_s[\"LightGBM\"], n_params[\"LightGBM\"], _ = load_ck(cache, \"LightGBM\")\n",
    "    else:\n",
    "        log(\"LightGBM ...\")\n",
    "        t0 = time.time()\n",
    "        lg = lgb.LGBMRegressor(n_estimators=3000, learning_rate=0.05, num_leaves=127, min_child_samples=30, subsample=0.8,\n",
    "                               subsample_freq=1, colsample_bytree=0.8, reg_lambda=1.0, n_jobs=-1, random_state=SEED, verbose=-1)\n",
    "        lg.fit(Xl[\"tr\"], D[\"tr\"], eval_set=[(Xl[\"va\"], D[\"va\"])], eval_metric=\"l2\", categorical_feature=[\"state_code\"],\n",
    "               callbacks=[lgb.early_stopping(60, verbose=False)])\n",
    "        val_pred[\"LightGBM\"], te_pred[\"LightGBM\"] = lg.predict(Xl[\"va\"]), lg.predict(Xl[\"te\"])\n",
    "        fit_s[\"LightGBM\"] = time.time() - t0\n",
    "        n_params[\"LightGBM\"] = int(lg.booster_.num_trees())\n",
    "        joblib.dump(lg, cache / \"lgbm.joblib\", compress=3)\n",
    "        save_ck(cache, \"LightGBM\", val_pred[\"LightGBM\"], te_pred[\"LightGBM\"], fit_s[\"LightGBM\"], n_params[\"LightGBM\"])\n",
    "\n",
    "    # ---- out-of-fold forest predictions for the hybrid (grouped by station so they are honest) ----\n",
    "    if (cache / \"oof.npy\").exists():\n",
    "        log(\"out-of-fold Random Forest predictions: loaded from checkpoint\")\n",
    "        oof = np.load(cache / \"oof.npy\")\n",
    "        t_oof = float(np.load(cache / \"t_oof.npy\"))\n",
    "    else:\n",
    "        log(\"out-of-fold Random Forest predictions for the hybrid ...\")\n",
    "        t0 = time.time()\n",
    "        oof = np.zeros(len(tr_idx))\n",
    "        for a_, b_ in GroupKFold(3).split(Xtab[\"tr\"], groups=f.sid.values[tr_idx]):\n",
    "            oof[b_] = new_rf(args.quick).fit(Xtab[\"tr\"].iloc[a_], D[\"tr\"][a_]).predict(Xtab[\"tr\"].iloc[b_])\n",
    "        t_oof = time.time() - t0\n",
    "        np.save(cache / \"oof.npy\", oof)\n",
    "        np.save(cache / \"t_oof.npy\", np.array(t_oof))\n",
    "\n",
    "    # ---- deep-learning models ----\n",
    "    nn_models = {}\n",
    "    for kind in NN_KINDS:\n",
    "        hy = kind == \"Hybrid RF-LSTM\"\n",
    "        if _ck(cache, kind).exists() and (cache / f\"{kind.replace(' ', '_')}.keras\").exists():\n",
    "            import keras\n",
    "            log(f\"{kind}: loaded from checkpoint\")\n",
    "            nn_models[kind] = keras.saving.load_model(cache / f\"{kind.replace(' ', '_')}.keras\", compile=False)\n",
    "            val_pred[kind], te_pred[kind], fit_s[kind], n_params[kind], curves[kind] = load_ck(cache, kind)\n",
    "        else:\n",
    "            log(f\"{kind} ...\")\n",
    "            ins = {\"tr\": gf.nn_inputs(R[\"tr\"], oof if hy else None),\n",
    "                   \"va\": gf.nn_inputs(R[\"va\"], rf_va if hy else None),\n",
    "                   \"te\": gf.nn_inputs(R[\"te\"], rf_te if hy else None)}\n",
    "            t0 = time.time()\n",
    "            model, curve = train_nn(kind, ins[\"tr\"], D[\"tr\"], ins[\"va\"], D[\"va\"], n_states, epochs)\n",
    "            fit_s[kind] = time.time() - t0 + (fit_s[\"Random Forest\"] + t_oof if hy else 0)\n",
    "            val_pred[kind] = model.predict(ins[\"va\"], batch_size=4096, verbose=0)[:, 0] * gf.DELTA_SCALE\n",
    "            te_pred[kind] = model.predict(ins[\"te\"], batch_size=4096, verbose=0)[:, 0] * gf.DELTA_SCALE\n",
    "            n_params[kind] = int(model.count_params())\n",
    "            curves[kind] = [float(x) for x in curve]\n",
    "            nn_models[kind] = model\n",
    "            model.save(cache / f\"{kind.replace(' ', '_')}.keras\")\n",
    "            save_ck(cache, kind, val_pred[kind], te_pred[kind], fit_s[kind], n_params[kind], curves[kind])\n",
    "            del ins\n",
    "        log(f\"  {kind}: validation RMSE {np.sqrt(np.mean((D['va'] - val_pred[kind]) ** 2)):.4f} m\")\n",
    "\n",
    "    # ---- evaluate ----\n",
    "    rows = {\"Persistence (copy last level)\": gp.reg_metrics(y_te, L0[\"te\"], L0[\"te\"])}\n",
    "    val_rmse = {}\n",
    "    for name in val_pred:\n",
    "        rows[name] = gp.reg_metrics(y_te, L0[\"te\"] + te_pred[name], L0[\"te\"])\n",
    "        val_rmse[name] = float(np.sqrt(np.mean((D[\"va\"] - val_pred[name]) ** 2)))\n",
    "    tab = pd.DataFrame(rows).T\n",
    "    tab[\"val_RMSE_m\"] = pd.Series(val_rmse)\n",
    "    tab[\"fit_seconds\"] = pd.Series(fit_s).round(0)\n",
    "    tab[\"size\"] = pd.Series(n_params)\n",
    "    best = min(val_rmse, key=val_rmse.get)\n",
    "    tab[\"selected\"] = [n == best for n in tab.index]\n",
    "    tab.to_csv(out / \"model_comparison.csv\")\n",
    "    log(\"\\n\" + tab[[\"val_RMSE_m\", \"R2_level\", \"RMSE_m\", \"MAE_m\", \"within_1m_%\", \"within_2m_%\", \"R2_of_change\", \"fit_seconds\"]].round(3).to_string())\n",
    "    log(f\"SELECTED (lowest validation RMSE): {best}\")\n",
    "\n",
    "    # ---- save the selected model + its dependencies ----\n",
    "    if best in (\"Random Forest\", \"Hybrid RF-LSTM\"):\n",
    "        joblib.dump(rf, out / \"rf_model.joblib\", compress=3)\n",
    "    if best == \"LightGBM\":\n",
    "        joblib.dump(lg, out / \"lgbm_model.joblib\", compress=3)\n",
    "    if best in nn_models:\n",
    "        nn_models[best].save(out / \"best_nn.keras\")\n",
    "\n",
    "    # ---- predictive distribution: residual quantiles by depth band, from VALIDATION errors ----\n",
    "    res_va = D[\"va\"] - val_pred[best]\n",
    "    pred_lvl_va = np.clip(L0[\"va\"] + val_pred[best], 0, None)\n",
    "    edges = np.array([0, 3, 6, 10, 15, 25, 50, 1e9])\n",
    "    allq = np.percentile(res_va, np.arange(1, 100))\n",
    "    qs = []\n",
    "    for i in range(len(edges) - 1):\n",
    "        sel = (pred_lvl_va >= edges[i]) & (pred_lvl_va < edges[i + 1])\n",
    "        qs.append(np.percentile(res_va[sel], np.arange(1, 100)) if sel.sum() >= 300 else allq)\n",
    "    state_codes = {str(r.state): int(r.state_code) for r in f.drop_duplicates(\"state_code\")[[\"state\", \"state_code\"]].itertuples()}\n",
    "    bundle = {\"kind\": best, \"rule\": RULE, \"resid_edges\": edges, \"resid_q\": np.array(qs), \"state_codes\": state_codes,\n",
    "              \"background\": R[\"tr\"].sample(40, random_state=SEED).reset_index(drop=True).to_dict(\"list\"), \"raw_cols\": gf.RAW_COLS}\n",
    "    joblib.dump(bundle, out / \"forecaster_bundle.joblib\")\n",
    "\n",
    "    # ---- check the saved model reloads and gives the same numbers ----\n",
    "    fcst = gf.GroundwaterForecaster(out)\n",
    "    chk = fcst.delta(R[\"te\"].iloc[:2000])\n",
    "    log(f\"reload check: max |difference| vs training run = {np.abs(chk - te_pred[best][:2000]).max():.2e} m\")\n",
    "\n",
    "    # ---- calibrated range + class accuracy by confidence on the TEST period ----\n",
    "    log(\"class accuracy and range coverage on the test period ...\")\n",
    "    tr_trend = gp.station_trends(m, upto_mi=gp.TRAIN_END)\n",
    "    sd, sl = gp.attach_trend(f.iloc[te_idx], tr_trend)\n",
    "    pred_lvl_te = np.clip(L0[\"te\"] + te_pred[best], 0, None)\n",
    "    lo, hi, probs = gf.predictive_distribution(edges, bundle[\"resid_q\"], RULE, pred_lvl_te, sd, sl)\n",
    "    cls_true = gp.sustainability_class(y_te, sd, sl)\n",
    "    cls_head = gp.sustainability_class(pred_lvl_te, sd, sl)\n",
    "    p_head = probs[np.arange(len(probs)), [gp.CLASSES.index(c) for c in cls_head]]\n",
    "    conf_rows = []\n",
    "    for thr in (0.0, 0.6, 0.8, 0.9, 0.95, 0.99):\n",
    "        mk = p_head >= thr\n",
    "        conf_rows.append({\"min_confidence\": thr, \"share_of_cases_%\": float(mk.mean() * 100),\n",
    "                          \"class_accuracy_%\": float((cls_head[mk] == cls_true[mk]).mean() * 100)})\n",
    "    cov = float(np.mean((y_te >= lo) & (y_te <= hi)) * 100)\n",
    "    log(\"class accuracy by confidence: \" + \"; \".join(f\"{r['min_confidence']:.2f}: {r['class_accuracy_%']:.1f}% on {r['share_of_cases_%']:.0f}%\" for r in conf_rows))\n",
    "    log(f\"80% range contained the true reading {cov:.1f}% of the time (mean width {np.mean(hi - lo):.2f} m)\")\n",
    "\n",
    "    # ---- global explanation: which cause matters most ----\n",
    "    log(\"exact Shapley values for 250 test cases ...\")\n",
    "    samp = rng.choice(len(R[\"te\"]), size=min(250, len(R[\"te\"])), replace=False)\n",
    "    phi, base, fx = gf.group_shapley(fcst.delta, R[\"te\"].iloc[samp], pd.DataFrame(bundle[\"background\"]).iloc[:25])\n",
    "    add_err = float(np.abs(base + phi.sum(axis=1) - fx).max())\n",
    "    imp = pd.Series(np.abs(phi).mean(axis=0), index=list(gf.GROUPS))\n",
    "    log(f\"Shapley check: max |base + sum(effects) - prediction| = {add_err:.2e} m;  importance: \" +\n",
    "        \", \".join(f\"{k} {v:.2f}\" for k, v in imp.sort_values(ascending=False).items()))\n",
    "\n",
    "    # ---- charts + metrics ----\n",
    "    chart_models(tab, best, out / \"01_model_comparison.png\")\n",
    "    chart_best(y_te, pred_lvl_te, best, out / \"02_selected_model_actual_vs_predicted.png\")\n",
    "    chart_importance(imp, out / \"03_driver_importance.png\")\n",
    "    if curves:\n",
    "        chart_curves(curves, out / \"04_deep_learning_validation_loss.png\")\n",
    "    metrics = {\"data\": info, \"rows\": {\"train\": int(len(tr_idx)), \"validation\": int(len(va_idx)), \"test\": int(len(te_idx))},\n",
    "               \"selected_model\": best, \"quick_mode\": bool(args.quick), \"epochs\": epochs,\n",
    "               \"comparison\": json.loads(tab.round(5).to_json(orient=\"index\")),\n",
    "               \"class_accuracy_by_confidence\": conf_rows,\n",
    "               \"interval_80_test\": {\"coverage_%\": cov, \"mean_width_m\": float(np.mean(hi - lo))},\n",
    "               \"driver_importance_m\": {k: float(v) for k, v in imp.items()},\n",
    "               \"shapley_additivity_max_error_m\": add_err, \"training_curves\": curves}\n",
    "    json.dump(metrics, open(out / \"metrics.json\", \"w\"), indent=2)\n",
    "    log(\"DONE. Files written to \" + str(out.resolve()))\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
